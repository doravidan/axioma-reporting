@model List<AxiomaReporting.Core.Entities.ReportRow>
@{
  ViewData["Title"] = "דיווח חודשי";
  var employee = ViewBag.Employee as AxiomaReporting.Core.Entities.User;
  var month = ViewBag.ActiveMonth as AxiomaReporting.Core.Entities.ReportingMonth;
  var report = ViewBag.Report as AxiomaReporting.Core.Entities.Report;
  var allocation = ViewBag.Allocation as AxiomaReporting.Core.Entities.Allocation;
  bool canEdit = ViewBag.CanEdit ?? false;
  int allocationId = ViewBag.AllocationId ?? 0;
  bool deadlinePassed = ViewBag.DeadlinePassed ?? false;
  bool deadlineOverrideActive = ViewBag.DeadlineOverrideActive ?? false;
  int? editRowId = ViewBag.EditRowId as int?;
  string? returnUrl = ViewBag.ReturnUrl as string;
  string? deadlineBlockMessage = ViewBag.DeadlineBlockMessage as string;
  string reportRowVersion = report?.RowVersion != null
    ? Convert.ToBase64String(report.RowVersion)
    : string.Empty;
  var reportAttachments = ViewBag.ReportAttachments as List<AxiomaReporting.Core.Entities.DocumentAttachment>
    ?? new List<AxiomaReporting.Core.Entities.DocumentAttachment>();

  var districts = allocation?.AllocationDistricts.Select(x => x.District).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.District>();
  var localities = allocation?.AllocationLocalities.Select(x => x.Locality).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.Locality>();
  var frameworks = allocation?.AllocationFrameworks.Select(x => x.Framework).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.Framework>();
  var edPrograms = allocation?.AllocationEducationalPrograms.Select(x => x.EducationalProgram).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.EducationalProgram>();
  var domains = allocation?.AllocationDomains.Select(x => x.Domain).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.Domain>();
  var subjects = allocation?.AllocationSubjects.Select(x => x.Subject).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.Subject>();
  var discCodes = allocation?.AllocationDiscussionCodes.Select(x => x.DiscussionCode).Where(x => x != null).Select(x => x!).ToList()
    ?? new List<AxiomaReporting.Core.Entities.DiscussionCode>();
  // שכבה (grade level) is a universal list (חובה, א–יב, …), not employee-specific,
  // so it is global like כיתה — supplied by the controller, not the allocation.
  var gradeLevels = ViewBag.AllGradeLevels as List<AxiomaReporting.Core.Entities.GradeLevel>
    ?? new List<AxiomaReporting.Core.Entities.GradeLevel>();
  // כיתה and the three מסקנה (conclusion) lists are global lookups (same for every report),
  // supplied by the controller — not scoped to the allocation's junction rows.
  var allClasses = ViewBag.AllClasses as List<AxiomaReporting.Core.Entities.SchoolClass>
    ?? new List<AxiomaReporting.Core.Entities.SchoolClass>();
  var classConclusions = ViewBag.ClassConclusions as List<AxiomaReporting.Core.Entities.ClassConclusion>
    ?? new List<AxiomaReporting.Core.Entities.ClassConclusion>();
  var frameworkConclusions = ViewBag.FrameworkConclusions as List<AxiomaReporting.Core.Entities.FrameworkConclusion>
    ?? new List<AxiomaReporting.Core.Entities.FrameworkConclusion>();
  var locationConclusions = ViewBag.LocationConclusions as List<AxiomaReporting.Core.Entities.LocalityDistrictNational>
    ?? new List<AxiomaReporting.Core.Entities.LocalityDistrictNational>();
  var requiredFields = ViewBag.RequiredReportFields as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
  bool Req(string field) => requiredFields.Contains(field);
  string Star(string field) => Req(field) ? " *" : "";
  // תווית מסגרת משולבת: יישוב — סמל — שם (משוב בטא B35/B39)
  var frameworkLabels = ViewBag.FrameworkLabels as Dictionary<int, string> ?? new Dictionary<int, string>();
  string FrameworkLabel(int id, string? fallback) => frameworkLabels.TryGetValue(id, out var l) ? l : (fallback ?? "");
  var durationTokens = (allocation?.OutputDuration ?? "")
    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
  var durationOptions = durationTokens
    .Where(t => decimal.TryParse(t, out _))
    .Select(decimal.Parse)
    .OrderBy(v => v)
    .ToList();
  var durationUnlimited = durationTokens.Any(t =>
    t.Equals("Unlimited", StringComparison.OrdinalIgnoreCase) ||
    t.Equals("ללא הגבלה", StringComparison.OrdinalIgnoreCase));

  var inlineLookupData = new Dictionary<string, object>
  {
    ["DistrictId"] = districts.Select(x => new { id = x.Id, text = x.Description }),
    ["LocalityId"] = localities.Select(x => new { id = x.Id, text = x.Description }),
    ["FrameworkId"] = frameworks.Select(x => new { id = x.Id, text = FrameworkLabel(x.Id, x.Description) }),
    ["EducationalProgramId"] = edPrograms.Select(x => new { id = x.Id, text = x.Description }),
    ["DomainId"] = domains.Select(x => new { id = x.Id, text = x.Description }),
    ["Subject1Id"] = subjects.Select(x => new { id = x.Id, text = x.Description }),
    ["Subject2Id"] = subjects.Select(x => new { id = x.Id, text = x.Description }),
    ["DiscussionCodeId"] = discCodes.Select(x => new { id = x.Id, text = x.Description }),
    ["ConclusionClassId"] = classConclusions.Select(x => new { id = x.Id, text = x.Description }),
    ["ConclusionFrameworkId"] = frameworkConclusions.Select(x => new { id = x.Id, text = x.Description }),
    ["ConclusionLocationId"] = locationConclusions.Select(x => new { id = x.Id, text = x.Description }),
    ["GradeLevelId"] = gradeLevels.Select(x => new { id = x.Id, text = x.Description }),
    ["ClassId"] = allClasses.Select(x => new { id = x.Id, text = x.Description })
  };

  string FieldAttrs(string field, string type = "select", bool optional = false) =>
    canEdit ? $" class=\"editable-cell\" data-edit-field=\"{field}\" data-edit-type=\"{type}\" data-edit-optional=\"{optional.ToString().ToLowerInvariant()}\" title=\"לחץ לעריכת התא\"" : string.Empty;
  string StatusText(int? statusId, string? name) => statusId switch
  {
    1 => "טיוטה",
    2 => "בהזנה",
    3 => "ממתין לאישור",
    4 => "מאושר",
    5 => "הוחזר לתיקון",
    _ => name ?? ""
  };
}

@if (canEdit)
{
  <style>
    #reportTable td.editable-cell {
      cursor: pointer;
      position: relative;
    }

    #reportTable td.editable-cell:hover {
      background: #fff7ed;
      box-shadow: inset 0 0 0 1px #e06a2f;
    }

    #reportTable td.cell-editing {
      min-width: 180px;
      background: #fff7ed;
    }

    #reportTable .cell-edit-actions {
      display: flex;
      gap: .25rem;
      margin-top: .25rem;
      justify-content: flex-start;
    }

    #reportTable .cell-edit-error {
      color: #b42318;
      font-weight: 700;
      font-size: .8rem;
      margin-top: .25rem;
      white-space: normal;
    }
  </style>
}

<div class="container-fluid mt-3">
  @if (!string.IsNullOrWhiteSpace(returnUrl))
  {
    <div class="mb-3">
      <a class="btn btn-outline-secondary btn-sm" href="@returnUrl">חזרה לדשבורד דיווחים</a>
    </div>
  }

  @if (TempData["Success"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite" aria-atomic="true">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }
  @if (TempData["Errors"] != null)
  {
    <div class="alert alert-danger" role="alert" aria-live="assertive" aria-atomic="true">
      @Html.Raw(string.Join("<br/>", (TempData["Errors"]!.ToString() ?? "").Split('|')))
      @if (TempData["ExcelErrorPdf"] != null)
      {
        <div class="mt-2">
          <a href="@TempData["ExcelErrorPdf"]" target="_blank" class="btn btn-sm btn-outline-danger">הורד PDF שגיאות</a>
        </div>
      }
    </div>
  }

  @if (!string.IsNullOrEmpty(deadlineBlockMessage))
  {
    <div class="alert alert-warning" role="alert" aria-live="polite" aria-atomic="true">
      @deadlineBlockMessage
    </div>
  }
  else if (deadlineOverrideActive)
  {
    <div class="alert alert-info" role="alert" aria-live="polite" aria-atomic="true">
      מצב דריסה — המועד עבר
    </div>
  }

  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-3"><strong>עובד:</strong> @employee?.FirstName @employee?.LastName</div>
        <div class="col-md-3"><strong>ת.ז:</strong> @employee?.IdNumber</div>
        <div class="col-md-3"><strong>קוד עובד:</strong> @employee?.EmployeeCode</div>
        <div class="col-md-3"><strong>חודש:</strong> @month?.Description</div>
        <div class="col-md-3"><strong>סטטוס:</strong> @StatusText(report?.StatusId, report?.Status?.Name)</div>
        <div class="col-md-3"><strong>שורות בהקצאה:</strong> @Model.Count / @allocation?.MonthlyRowAllocation</div>
        <div class="col-md-6 text-start">
          @{
            var allocsList = ViewBag.Allocations as List<AxiomaReporting.Core.Entities.Allocation>;
          }
          @if (allocsList != null && allocsList.Count > 1)
          {
            <a asp-action="Index" asp-route-userId="@employee?.Id" class="btn btn-outline-secondary btn-sm">שנה פרויקט</a>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">
      <h5 class="mb-0">מסמכי הדיווח</h5>
    </div>
    <div class="card-body">
      @if (canEdit)
      {
        <div class="row g-2 align-items-end mb-3">
          <div class="col-md-5">
            <label class="form-label" for="report-file-description">תיאור מסמך</label>
            <input type="text" id="report-file-description" class="form-control"
                   maxlength="1000" placeholder="תיאור המסמך" />
          </div>
          <div class="col-md-5">
            <label class="form-label" for="report-file-upload">בחר מסמך</label>
            <input type="file" id="report-file-upload" class="form-control"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
          </div>
          <div class="col-md-2">
            <button type="button" class="btn btn-primary w-100" onclick="uploadAttachment()">העלה מסמך</button>
          </div>
        </div>
      }

      @if (reportAttachments.Any())
      {
        <div class="table-responsive">
          <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
              <tr>
                <th>שם קובץ</th>
                <th>תיאור</th>
                <th>תאריך העלאה</th>
                @if (canEdit) { <th>פעולות</th> }
              </tr>
            </thead>
            <tbody>
              @foreach (var file in reportAttachments)
              {
                <tr>
                  <td><a href="@file.FilePath" target="_blank">@file.FileName</a></td>
                  <td>@file.Description</td>
                  <td>@file.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                  @if (canEdit)
                  {
                    <td>
                      <button type="button" class="btn btn-sm btn-outline-danger"
                              onclick="deleteAttachment(@file.Id)" aria-label="מחק" title="מחק">🗑</button>
                    </td>
                  }
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <div class="text-muted">אין מסמכים מצורפים לדיווח</div>
      }
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0" id="reportTableCaption">שורות דיווח</h5>
      @if (canEdit)
      {
        <button class="btn btn-primary btn-sm" onclick="addRow()" aria-label="הוסף שורת דיווח חדשה">+ הוסף שורה</button>
      }
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered table-sm mb-0" id="reportTable" aria-labelledby="reportTableCaption">
          <thead class="table-light">
            <tr>
              @* עמודת הפעולות ראשונה מימין (משוב לקוח Sheet4 #1) *@
              @if (canEdit) { <th scope="col">פעולות</th> }
              <th scope="col" class="sortable" aria-sort="none">מס"ד</th>
              <th scope="col" class="sortable" aria-sort="none">תאריך</th>
              <th scope="col" class="sortable" aria-sort="none">משך</th>
              <th scope="col" class="sortable" aria-sort="none">מחוז</th>
              <th scope="col" class="sortable" aria-sort="none">ישוב</th>
              <th scope="col" class="sortable" aria-sort="none">מסגרת חינוכית</th>
              <th scope="col" class="sortable" aria-sort="none">תוכנית</th>
              <th scope="col" class="sortable" aria-sort="none">תחום</th>
              <th scope="col" class="sortable" aria-sort="none">נושא 1</th>
              <th scope="col" class="sortable" aria-sort="none">נושא 2</th>
              <th scope="col" class="sortable" aria-sort="none">קיום דיון</th>
              <th scope="col" class="sortable" aria-sort="none">מסקנה-כיתה</th>
              <th scope="col" class="sortable" aria-sort="none">מסקנה-מסגרת</th>
              <th scope="col" class="sortable" aria-sort="none">מסקנה-מיקום</th>
              <th scope="col" class="sortable" aria-sort="none">שכבה</th>
              <th scope="col" class="sortable" aria-sort="none">כיתה</th>
              <th scope="col">הערות</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in Model)
            {
              var rowVersionB64 = row.RowVersion != null ? Convert.ToBase64String(row.RowVersion) : "";
              <tr data-row-id="@row.Id" data-row-version="@rowVersionB64">
                @if (canEdit)
                {
                  <td>
                    <button class="btn btn-sm btn-outline-secondary" onclick="editRow(@row.Id)"
                            aria-label="ערוך שורה @row.SequenceNumber">ערוך</button>
                    <button class="btn btn-sm btn-outline-dark" onclick="inlineEditRow(@row.Id)"
                            aria-label="ערוך שורה @row.SequenceNumber בטבלה">עריכה בשורה</button>
                    <button class="btn btn-sm btn-outline-primary" onclick="duplicateRow(@row.Id)"
                            aria-label="שכפל שורה @row.SequenceNumber">שכפל</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteRow(@row.Id)"
                            aria-label="מחק שורה @row.SequenceNumber">מחק</button>
                  </td>
                }
                <td>@row.SequenceNumber</td>
                <td @Html.Raw(FieldAttrs("MeetingDate", "date"))>@row.MeetingDate.ToString("dd/MM/yyyy")</td>
                <td @Html.Raw(FieldAttrs("MeetingDuration", "duration"))>@row.MeetingDuration</td>
                <td @Html.Raw(FieldAttrs("DistrictId"))>@row.District?.Description</td>
                <td @Html.Raw(FieldAttrs("LocalityId"))>@row.Locality?.Description</td>
                <td @Html.Raw(FieldAttrs("FrameworkId"))>@FrameworkLabel(row.FrameworkId, row.Framework?.Description)</td>
                <td @Html.Raw(FieldAttrs("EducationalProgramId"))>@row.EducationalProgram?.Description</td>
                <td @Html.Raw(FieldAttrs("DomainId"))>@row.Domain?.Description</td>
                <td @Html.Raw(FieldAttrs("Subject1Id"))>@row.Subject1?.Description</td>
                <td @Html.Raw(FieldAttrs("Subject2Id", optional: true))>@row.Subject2?.Description</td>
                <td @Html.Raw(FieldAttrs("DiscussionCodeId", optional: true))>@row.DiscussionCode?.Description</td>
                <td @Html.Raw(FieldAttrs("ConclusionClassId", optional: true))>@row.ConclusionClass?.Description</td>
                <td @Html.Raw(FieldAttrs("ConclusionFrameworkId", optional: true))>@row.ConclusionFramework?.Description</td>
                <td @Html.Raw(FieldAttrs("ConclusionLocationId", optional: true))>@row.ConclusionLocation?.Description</td>
                <td @Html.Raw(FieldAttrs("GradeLevelId", optional: true))>@row.GradeLevel?.Description</td>
                <td @Html.Raw(FieldAttrs("ClassId", optional: true))>@row.Class?.Description</td>
                <td @Html.Raw(FieldAttrs("Notes", "textarea", true))>@row.Notes</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  @if (report != null && Model.Any())
  {
    @* הורדת הדיווח לאקסל — זמין לעובד בכל סטטוס (בקשת לקוח Sheet7 #4) *@
    <div class="mt-3">
      <a asp-action="ExportMyReport" asp-route-reportId="@report.Id" asp-route-allocationId="@allocationId"
         class="btn btn-outline-success btn-sm">הורד דיווח לאקסל</a>
    </div>
  }

  @if (canEdit && report?.StatusId is 1 or 2 or 5)
  {
    <div class="mt-3 d-flex flex-wrap gap-2">
      <form asp-action="Submit" asp-route-reportId="@report?.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="allocationId" value="@allocationId" />
        <input type="hidden" name="rowVersion" value="@reportRowVersion" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="btn btn-success"
                onclick="return confirm('האם להגיש את הדיווח?')">הגשת דיווח</button>
      </form>
      @if (allocation?.AllowExcelUpload == true)
      {
        <a asp-action="DownloadExcelTemplate" class="btn btn-outline-secondary btn-sm">הורד תבנית אקסל</a>
        <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
          @Html.AntiForgeryToken()
          <input type="hidden" name="reportId" value="@report?.Id" />
          <input type="hidden" name="allocationId" value="@allocationId" />
          <input type="hidden" name="returnUrl" value="@returnUrl" />
          <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required />
          <button type="submit" class="btn btn-outline-primary btn-sm"
                  onclick="return confirm('העלאת אקסל תחליף את שורות ההקצאה הנוכחיות. להמשיך?')">ייבוא אקסל</button>
        </form>
      }
    </div>
  }
</div>

@if (canEdit)
{
  <div class="modal fade" id="rowModal" tabindex="-1"
       aria-labelledby="rowModalTitle" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-xl" role="dialog" aria-modal="true">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="rowModalTitle">עריכת שורת דיווח</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור חלון עריכה"></button>
        </div>
        <div class="modal-body">
          <form id="rowForm" aria-label="טופס שורת דיווח" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="rowId" name="row.Id" value="0" />
            <input type="hidden" id="rowRowVersion" name="rowVersion" value="" />
            <input type="hidden" name="reportId" value="@report?.Id" />
            <input type="hidden" name="allocationId" value="@allocationId" />
            <div class="row g-2">
              <div class="col-md-2">
                <label class="form-label" for="fieldDate">תאריך@(Star("MeetingDate"))</label>
                <input type="date" id="fieldDate" name="row.MeetingDate" class="form-control"
                       required="@Req("MeetingDate")" aria-required="@(Req("MeetingDate") ? "true" : "false")"
                       aria-describedby="rowErrors" />
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldDuration">משך תפוקה@(Star("MeetingDuration"))</label>
                @if (durationOptions.Any() && !durationUnlimited)
                {
                  <select id="fieldDuration" name="row.MeetingDuration" class="form-select"
                          required="@Req("MeetingDuration")" aria-required="@(Req("MeetingDuration") ? "true" : "false")"
                          aria-describedby="rowErrors">
                    <option value="">בחר...</option>
                    @foreach (var value in durationOptions)
                    {
                      <option value="@value">@value</option>
                    }
                  </select>
                }
                else
                {
                  <input type="number" id="fieldDuration" name="row.MeetingDuration" class="form-control"
                         step="0.5" min="0.5" required="@Req("MeetingDuration")"
                         aria-required="@(Req("MeetingDuration") ? "true" : "false")"
                         aria-describedby="rowErrors" />
                }
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldDistrict">מחוז@(Star("DistrictId"))</label>
                <select id="fieldDistrict" name="row.DistrictId" class="form-select"
                        required="@Req("DistrictId")" aria-required="@(Req("DistrictId") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in districts) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldLocality">ישוב@(Star("LocalityId"))</label>
                <select id="fieldLocality" name="row.LocalityId" class="form-select"
                        required="@Req("LocalityId")" aria-required="@(Req("LocalityId") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in localities) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldFramework">מסגרת חינוכית@(Star("FrameworkId"))</label>
                <select id="fieldFramework" name="row.FrameworkId" class="form-select"
                        required="@Req("FrameworkId")" aria-required="@(Req("FrameworkId") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in frameworks) { <option value="@item.Id">@FrameworkLabel(item.Id, item.Description)</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldEduProgram">תוכנית@(Star("EducationalProgramId"))</label>
                <select id="fieldEduProgram" name="row.EducationalProgramId" class="form-select"
                        required="@Req("EducationalProgramId")" aria-required="@(Req("EducationalProgramId") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in edPrograms) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldDomain">תחום@(Star("DomainId"))</label>
                <select id="fieldDomain" name="row.DomainId" class="form-select"
                        required="@Req("DomainId")" aria-required="@(Req("DomainId") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in domains) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldSubject1">נושא 1@(Star("Subject1Id"))</label>
                <select id="fieldSubject1" name="row.Subject1Id" class="form-select"
                        required="@Req("Subject1Id")" aria-required="@(Req("Subject1Id") ? "true" : "false")">
                  <option value="">בחר...</option>
                  @foreach (var item in subjects) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldSubject2">נושא 2@(Star("Subject2Id"))</label>
                <select id="fieldSubject2" name="row.Subject2Id" class="form-select"
                        required="@Req("Subject2Id")" aria-required="@(Req("Subject2Id") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in subjects) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldDiscussion">קיום דיון@(Star("DiscussionCodeId"))</label>
                <select id="fieldDiscussion" name="row.DiscussionCodeId" class="form-select"
                        required="@Req("DiscussionCodeId")" aria-required="@(Req("DiscussionCodeId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in discCodes) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldConclusionClass">מסקנה - כיתה@(Star("ConclusionClassId"))</label>
                <select id="fieldConclusionClass" name="row.ConclusionClassId" class="form-select"
                        required="@Req("ConclusionClassId")" aria-required="@(Req("ConclusionClassId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in classConclusions) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldConclusionFramework">מסקנה - מסגרת@(Star("ConclusionFrameworkId"))</label>
                <select id="fieldConclusionFramework" name="row.ConclusionFrameworkId" class="form-select"
                        required="@Req("ConclusionFrameworkId")" aria-required="@(Req("ConclusionFrameworkId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in frameworkConclusions) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldConclusionLocation">מסקנה - מיקום@(Star("ConclusionLocationId"))</label>
                <select id="fieldConclusionLocation" name="row.ConclusionLocationId" class="form-select"
                        required="@Req("ConclusionLocationId")" aria-required="@(Req("ConclusionLocationId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in locationConclusions) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldGradeLevel">שכבה@(Star("GradeLevelId"))</label>
                <select id="fieldGradeLevel" name="row.GradeLevelId" class="form-select"
                        required="@Req("GradeLevelId")" aria-required="@(Req("GradeLevelId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in gradeLevels) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label" for="fieldClass">כיתה@(Star("ClassId"))</label>
                <select id="fieldClass" name="row.ClassId" class="form-select"
                        required="@Req("ClassId")" aria-required="@(Req("ClassId") ? "true" : "false")">
                  <option value="">---</option>
                  @foreach (var item in allClasses) { <option value="@item.Id">@item.Description</option> }
                </select>
              </div>
              <div class="col-12">
                <label class="form-label" for="fieldNotes">הערות@(Star("Notes"))</label>
                <textarea id="fieldNotes" name="row.Notes" class="form-control" rows="2"
                          required="@Req("Notes")" aria-required="@(Req("Notes") ? "true" : "false")"></textarea>
              </div>
            </div>
            <div id="rowErrors" class="alert alert-danger mt-2" role="alert"
                 aria-live="assertive" aria-atomic="true" style="display:none"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
          <button type="button" class="btn btn-primary" onclick="saveRow()">שמור שורה</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let rowModal = null;
    const inlineLookupData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(inlineLookupData));
    const inlineDurationOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(durationOptions));
    const inlineDurationUnlimited = @Json.Serialize(durationUnlimited);
    const inlineReportId = @report?.Id;
    const inlineAllocationId = @allocationId;
    const reportUrls = {
      getRow: '@Url.Action("GetRow", "Report")',
      saveRow: '@Url.Action("SaveRow", "Report")',
      deleteRow: '@Url.Action("DeleteRow", "Report")',
      uploadAttachment: '@Url.Action("UploadAttachment", "Report")',
      deleteAttachment: '@Url.Action("DeleteAttachment", "Report")'
    };

    function withQuery(url, key, value) {
      const separator = url.includes('?') ? '&' : '?';
      return `${url}${separator}${encodeURIComponent(key)}=${encodeURIComponent(value)}`;
    }

    function htmlEscape(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function selectHtml(name, value, optional) {
      const items = inlineLookupData[name] || [];
      const emptyText = optional ? '---' : 'בחר...';
      const options = [`<option value="">${emptyText}</option>`].concat(items.map(item => {
        const selected = String(item.id) === String(value ?? '') ? ' selected' : '';
        return `<option value="${htmlEscape(item.id)}"${selected}>${htmlEscape(item.text)}</option>`;
      }));
      return `<select class="form-select form-select-sm inline-field" data-name="row.${name}">${options.join('')}</select>`;
    }

    function durationHtml(value) {
      if (inlineDurationOptions.length && !inlineDurationUnlimited) {
        const options = ['<option value="">בחר...</option>'].concat(inlineDurationOptions.map(item => {
          const selected = String(item) === String(value ?? '') ? ' selected' : '';
          return `<option value="${htmlEscape(item)}"${selected}>${htmlEscape(item)}</option>`;
        }));
        return `<select class="form-select form-select-sm inline-field" data-name="row.MeetingDuration">${options.join('')}</select>`;
      }

      return `<input type="number" step="0.5" min="0.5" class="form-control form-control-sm inline-field" data-name="row.MeetingDuration" value="${htmlEscape(value ?? '')}" />`;
    }

    function getLookupText(field, value) {
      if (!value) return '';
      const item = (inlineLookupData[field] || []).find(x => String(x.id) === String(value));
      return item ? item.text : '';
    }

    function formatCellValue(field, value) {
      if (field === 'MeetingDate') {
        if (!value) return '';
        const parts = String(value).split('-');
        return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : value;
      }

      if (field === 'MeetingDuration' || field === 'Notes') {
        return value || '';
      }

      return getLookupText(field, value);
    }

    function cellEditorHtml(field, type, optional, value) {
      if (type === 'date') {
        return `<input type="date" class="form-control form-control-sm cell-field" value="${htmlEscape(value || '')}" />`;
      }

      if (type === 'duration') {
        if (inlineDurationOptions.length && !inlineDurationUnlimited) {
          const options = ['<option value="">בחר...</option>'].concat(inlineDurationOptions.map(item => {
            const selected = String(item) === String(value ?? '') ? ' selected' : '';
            return `<option value="${htmlEscape(item)}"${selected}>${htmlEscape(item)}</option>`;
          }));
          return `<select class="form-select form-select-sm cell-field">${options.join('')}</select>`;
        }

        return `<input type="number" step="0.5" min="0.5" class="form-control form-control-sm cell-field" value="${htmlEscape(value ?? '')}" />`;
      }

      if (type === 'textarea') {
        return `<textarea class="form-control form-control-sm cell-field" rows="2">${htmlEscape(value || '')}</textarea>`;
      }

      const items = inlineLookupData[field] || [];
      const emptyText = optional ? '---' : 'בחר...';
      const options = [`<option value="">${emptyText}</option>`].concat(items.map(item => {
        const selected = String(item.id) === String(value ?? '') ? ' selected' : '';
        return `<option value="${htmlEscape(item.id)}"${selected}>${htmlEscape(item.text)}</option>`;
      }));
      return `<select class="form-select form-select-sm cell-field">${options.join('')}</select>`;
    }

    function appendRowFormData(data, row) {
      data.append('row.Id', row.id);
      data.append('row.MeetingDate', row.meetingDate || '');
      data.append('row.MeetingDuration', row.meetingDuration || '');
      data.append('row.DistrictId', row.districtId || '');
      data.append('row.LocalityId', row.localityId || '');
      data.append('row.FrameworkId', row.frameworkId || '');
      data.append('row.EducationalProgramId', row.educationalProgramId || '');
      data.append('row.DomainId', row.domainId || '');
      data.append('row.Subject1Id', row.subject1Id || '');
      data.append('row.Subject2Id', row.subject2Id || '');
      data.append('row.DiscussionCodeId', row.discussionCodeId || '');
      data.append('row.ConclusionClassId', row.conclusionClassId || '');
      data.append('row.ConclusionFrameworkId', row.conclusionFrameworkId || '');
      data.append('row.ConclusionLocationId', row.conclusionLocationId || '');
      data.append('row.GradeLevelId', row.gradeLevelId || '');
      data.append('row.ClassId', row.classId || '');
      data.append('row.Notes', row.notes || '');
    }

    function setRowField(row, field, value) {
      const map = {
        MeetingDate: 'meetingDate',
        MeetingDuration: 'meetingDuration',
        DistrictId: 'districtId',
        LocalityId: 'localityId',
        FrameworkId: 'frameworkId',
        EducationalProgramId: 'educationalProgramId',
        DomainId: 'domainId',
        Subject1Id: 'subject1Id',
        Subject2Id: 'subject2Id',
        DiscussionCodeId: 'discussionCodeId',
        ConclusionClassId: 'conclusionClassId',
        ConclusionFrameworkId: 'conclusionFrameworkId',
        ConclusionLocationId: 'conclusionLocationId',
        GradeLevelId: 'gradeLevelId',
        ClassId: 'classId',
        Notes: 'notes'
      };
      row[map[field]] = value;
    }

    async function editCell(cell) {
      if (!cell?.classList.contains('editable-cell') || cell.classList.contains('cell-editing')) return;
      const tr = cell.closest('tr[data-row-id]');
      if (!tr || tr.dataset.inlineEditing === 'true') return;

      document.querySelectorAll('#reportTable td.cell-editing').forEach(cancelCellEdit);
      const field = cell.dataset.editField;
      const type = cell.dataset.editType || 'select';
      const optional = cell.dataset.editOptional === 'true';
      const rowId = tr.dataset.rowId;
      const resp = await fetch(withQuery(reportUrls.getRow, 'rowId', rowId));
      if (!resp.ok) {
        alert('לא ניתן לטעון את התא לעריכה');
        return;
      }

      const row = await resp.json();
      const key = {
        MeetingDate: 'meetingDate',
        MeetingDuration: 'meetingDuration',
        DistrictId: 'districtId',
        LocalityId: 'localityId',
        FrameworkId: 'frameworkId',
        EducationalProgramId: 'educationalProgramId',
        DomainId: 'domainId',
        Subject1Id: 'subject1Id',
        Subject2Id: 'subject2Id',
        DiscussionCodeId: 'discussionCodeId',
        ConclusionClassId: 'conclusionClassId',
        ConclusionFrameworkId: 'conclusionFrameworkId',
        ConclusionLocationId: 'conclusionLocationId',
        GradeLevelId: 'gradeLevelId',
        ClassId: 'classId',
        Notes: 'notes'
      }[field];

      cell.dataset.originalHtml = cell.innerHTML;
      cell.classList.add('cell-editing');
      cell.innerHTML = `
        ${cellEditorHtml(field, type, optional, row[key])}
        <div class="cell-edit-actions">
          <button type="button" class="btn btn-sm btn-primary" onclick="saveCellEdit(this)">שמור</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelCellEdit(this.closest('td'))">ביטול</button>
        </div>
        <div class="cell-edit-error" role="alert"></div>`;
      cell.querySelector('.cell-field')?.focus();
    }

    function cancelCellEdit(cell) {
      if (!cell?.dataset.originalHtml) return;
      cell.innerHTML = cell.dataset.originalHtml;
      cell.classList.remove('cell-editing');
      delete cell.dataset.originalHtml;
    }

    async function saveCellEdit(button) {
      const cell = button.closest('td');
      const tr = cell.closest('tr[data-row-id]');
      const field = cell.dataset.editField;
      const input = cell.querySelector('.cell-field');
      const rowId = tr.dataset.rowId;
      const resp = await fetch(withQuery(reportUrls.getRow, 'rowId', rowId));
      if (!resp.ok) {
        cell.querySelector('.cell-edit-error').textContent = 'לא ניתן לטעון את השורה לשמירה';
        return;
      }

      const row = await resp.json();
      const value = input.value || '';
      setRowField(row, field, value);

      const token = document.querySelector('[name=__RequestVerificationToken]').value;
      const data = new FormData();
      data.append('__RequestVerificationToken', token);
      data.append('reportId', inlineReportId);
      data.append('allocationId', inlineAllocationId);
      data.append('rowVersion', tr.getAttribute('data-row-version') || row.rowVersion || '');
      appendRowFormData(data, row);

      button.disabled = true;
      const saveResp = await fetch(reportUrls.saveRow, { method: 'POST', body: data });
      const result = await saveResp.json().catch(() => ({ success: false, error: 'שגיאה בשמירת התא' }));
      if (!result.success) {
        button.disabled = false;
        cell.querySelector('.cell-edit-error').innerHTML = (result.errors || [result.error || 'שגיאה בשמירת התא']).join('<br/>');
        return;
      }

      if (result.rowVersion) {
        tr.setAttribute('data-row-version', result.rowVersion);
      }
      cell.classList.remove('cell-editing');
      delete cell.dataset.originalHtml;
      cell.textContent = formatCellValue(field, value) || '---';
    }

    document.querySelectorAll('#reportTable td.editable-cell').forEach(cell => {
      cell.addEventListener('dblclick', () => editCell(cell));
      cell.addEventListener('click', () => editCell(cell));
    });

    async function inlineEditRow(id) {
      const tr = document.querySelector(`tr[data-row-id="${id}"]`);
      if (!tr || tr.dataset.inlineEditing === 'true') return;

      const resp = await fetch(withQuery(reportUrls.getRow, 'rowId', id));
      if (!resp.ok) {
        alert('לא ניתן לטעון את השורה לעריכה');
        return;
      }

      const row = await resp.json();
      tr.dataset.inlineEditing = 'true';
      document.querySelector(`tr[data-detail-for="${id}"]`)?.remove();

      const detail = document.createElement('tr');
      detail.className = 'table-warning-subtle';
      detail.dataset.detailFor = id;
      detail.innerHTML = `
        <td colspan="${tr.children.length}">
          <div class="row g-2 align-items-end">
            <div class="col-md-2"><label class="form-label">תאריך</label><input type="date" class="form-control form-control-sm inline-field" data-name="row.MeetingDate" value="${htmlEscape(row.meetingDate)}" /></div>
            <div class="col-md-2"><label class="form-label">משך</label>${durationHtml(row.meetingDuration)}</div>
            <div class="col-md-2"><label class="form-label">מחוז</label>${selectHtml('DistrictId', row.districtId, false)}</div>
            <div class="col-md-2"><label class="form-label">ישוב</label>${selectHtml('LocalityId', row.localityId, false)}</div>
            <div class="col-md-2"><label class="form-label">מסגרת חינוכית</label>${selectHtml('FrameworkId', row.frameworkId, false)}</div>
            <div class="col-md-2"><label class="form-label">תוכנית</label>${selectHtml('EducationalProgramId', row.educationalProgramId, false)}</div>
            <div class="col-md-2"><label class="form-label">תחום</label>${selectHtml('DomainId', row.domainId, false)}</div>
            <div class="col-md-2"><label class="form-label">נושא 1</label>${selectHtml('Subject1Id', row.subject1Id, false)}</div>
            <div class="col-md-2"><label class="form-label">נושא 2</label>${selectHtml('Subject2Id', row.subject2Id, true)}</div>
            <div class="col-md-2"><label class="form-label">קיום דיון</label>${selectHtml('DiscussionCodeId', row.discussionCodeId, true)}</div>
            <div class="col-md-2"><label class="form-label">מסקנה - כיתה</label>${selectHtml('ConclusionClassId', row.conclusionClassId, true)}</div>
            <div class="col-md-2"><label class="form-label">מסקנה - מסגרת</label>${selectHtml('ConclusionFrameworkId', row.conclusionFrameworkId, true)}</div>
            <div class="col-md-2"><label class="form-label">מסקנה - מיקום</label>${selectHtml('ConclusionLocationId', row.conclusionLocationId, true)}</div>
            <div class="col-md-2"><label class="form-label">שכבה</label>${selectHtml('GradeLevelId', row.gradeLevelId, true)}</div>
            <div class="col-md-2"><label class="form-label">כיתה</label>${selectHtml('ClassId', row.classId, true)}</div>
            <div class="col-md-6"><label class="form-label">הערות</label><textarea class="form-control form-control-sm inline-field" data-name="row.Notes" rows="2">${htmlEscape(row.notes || '')}</textarea></div>
            <div class="col-md-4 d-flex gap-2">
              <button type="button" class="btn btn-sm btn-primary" onclick="saveInlineRow(${id})">שמור</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelInlineRow(${id})">ביטול</button>
            </div>
            <div class="col-12 inline-row-errors text-danger small fw-bold" role="alert"></div>
          </div>
        </td>`;
      tr.after(detail);
    }

    function cancelInlineRow(id) {
      const tr = document.querySelector(`tr[data-row-id="${id}"]`);
      document.querySelector(`tr[data-detail-for="${id}"]`)?.remove();
      if (tr) tr.dataset.inlineEditing = 'false';
    }

    async function saveInlineRow(id) {
      const tr = document.querySelector(`tr[data-row-id="${id}"]`);
      const detail = document.querySelector(`tr[data-detail-for="${id}"]`);
      if (!tr || !detail) return;

      const token = document.querySelector('[name=__RequestVerificationToken]').value;
      const data = new FormData();
      data.append('__RequestVerificationToken', token);
      data.append('reportId', inlineReportId);
      data.append('allocationId', inlineAllocationId);
      data.append('row.Id', id);
      data.append('rowVersion', tr.getAttribute('data-row-version') || '');
      detail.querySelectorAll('.inline-field').forEach(field => {
        data.append(field.dataset.name, field.value || '');
      });

      const resp = await fetch(reportUrls.saveRow, { method: 'POST', body: data });
      const result = await resp.json();
      if (result.success) {
        location.reload();
        return;
      }

      const errorBox = detail.querySelector('.inline-row-errors');
      if (errorBox) {
        errorBox.innerHTML = (result.errors || [result.error || 'שגיאה בשמירת השורה']).join('<br/>');
      } else {
        alert(result.error || 'שגיאה בשמירת השורה');
      }
    }

    document.querySelectorAll('#reportTable th.sortable').forEach((header) => {
      // cellIndex = the header's true column position — stays correct regardless of
      // non-sortable columns (e.g. the actions column that is now first-from-right).
      const index = header.cellIndex;
      header.style.cursor = 'pointer';
      header.setAttribute('tabindex', '0');
      header.setAttribute('title', 'לחץ למיון לפי עמודה זו');
      header.addEventListener('click', () => sortReportTable(index, header));
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          sortReportTable(index, header);
        }
      });
    });

    function sortReportTable(index, header) {
      const tbody = document.querySelector('#reportTable tbody');
      document.querySelectorAll('tr[data-detail-for]').forEach(row => row.remove());
      document.querySelectorAll('tr[data-row-id]').forEach(row => row.dataset.inlineEditing = 'false');
      const rows = Array.from(tbody.querySelectorAll('tr[data-row-id]'));
      const descending = header.dataset.sortDir !== 'desc';
      document.querySelectorAll('#reportTable th.sortable').forEach(th => {
        th.dataset.sortDir = '';
        th.setAttribute('aria-sort', 'none');
      });
      header.dataset.sortDir = descending ? 'desc' : 'asc';
      header.setAttribute('aria-sort', descending ? 'descending' : 'ascending');

      rows.sort((a, b) => {
        const left = a.children[index]?.innerText.trim() || '';
        const right = b.children[index]?.innerText.trim() || '';
        const leftNum = Number(left.replace(',', '.'));
        const rightNum = Number(right.replace(',', '.'));
        const compare = Number.isNaN(leftNum) || Number.isNaN(rightNum)
          ? left.localeCompare(right, 'he')
          : leftNum - rightNum;
        return descending ? -compare : compare;
      });
      rows.forEach(row => tbody.appendChild(row));
    }

    function setSelect(id, value) {
      const el = document.getElementById(id);
      if (!el) return;
      const inst = window._axChoices && window._axChoices.get ? window._axChoices.get(el) : null;
      if (inst) {
        // Choices.js wraps the select — setting el.value directly does not update
        // its UI, so drive the instance API. NOTE: never call removeActiveItems()
        // on a single-select instance — it drops the item from the store for good;
        // selecting the placeholder ('' option) is the correct "clear".
        inst.setChoiceByValue(String(value ?? ''));
      } else {
        el.value = value || '';
      }
    }

    function addRow() {
      // NOTE: intentionally NOT form.reset() — it restores native select state behind
      // Choices.js' back and permanently desyncs the widgets. Clear fields explicitly.
      document.querySelectorAll('#rowForm input[type="date"], #rowForm input[type="number"], #rowForm textarea')
        .forEach(el => { el.value = ''; });
      document.querySelectorAll('#rowForm select').forEach(el => setSelect(el.id, ''));
      document.getElementById('rowId').value = '0';
      document.getElementById('rowRowVersion').value = '';
      document.getElementById('rowErrors').style.display = 'none';
      rowModal = rowModal || new bootstrap.Modal(document.getElementById('rowModal'));
      rowModal.show();
    }

    async function editRow(id) {
      document.getElementById('rowErrors').style.display = 'none';
      const resp = await fetch(withQuery(reportUrls.getRow, 'rowId', id));
      if (!resp.ok) {
        alert('לא ניתן לטעון את השורה לעריכה');
        return;
      }

      const row = await resp.json();
      document.getElementById('rowId').value = row.id;
      document.getElementById('rowRowVersion').value = row.rowVersion || '';
      document.getElementById('fieldDate').value = row.meetingDate;
      document.getElementById('fieldDuration').value = row.meetingDuration;
      setSelect('fieldDistrict', row.districtId);
      setSelect('fieldLocality', row.localityId);
      setSelect('fieldFramework', row.frameworkId);
      setSelect('fieldEduProgram', row.educationalProgramId);
      setSelect('fieldDomain', row.domainId);
      setSelect('fieldSubject1', row.subject1Id);
      setSelect('fieldSubject2', row.subject2Id);
      setSelect('fieldDiscussion', row.discussionCodeId);
      setSelect('fieldConclusionClass', row.conclusionClassId);
      setSelect('fieldConclusionFramework', row.conclusionFrameworkId);
      setSelect('fieldConclusionLocation', row.conclusionLocationId);
      setSelect('fieldGradeLevel', row.gradeLevelId);
      setSelect('fieldClass', row.classId);
      document.getElementById('fieldNotes').value = row.notes || '';
      rowModal = rowModal || new bootstrap.Modal(document.getElementById('rowModal'));
      rowModal.show();
    }

    async function duplicateRow(id) {
      document.getElementById('rowErrors').style.display = 'none';
      const resp = await fetch(withQuery(reportUrls.getRow, 'rowId', id));
      if (!resp.ok) {
        alert('לא ניתן לטעון את השורה לשכפול');
        return;
      }

      const row = await resp.json();
      document.getElementById('rowId').value = '0';
      document.getElementById('rowRowVersion').value = '';
      document.getElementById('fieldDate').value = row.meetingDate;
      document.getElementById('fieldDuration').value = row.meetingDuration;
      setSelect('fieldDistrict', row.districtId);
      setSelect('fieldLocality', row.localityId);
      setSelect('fieldFramework', row.frameworkId);
      setSelect('fieldEduProgram', row.educationalProgramId);
      setSelect('fieldDomain', row.domainId);
      setSelect('fieldSubject1', row.subject1Id);
      setSelect('fieldSubject2', row.subject2Id);
      setSelect('fieldDiscussion', row.discussionCodeId);
      setSelect('fieldConclusionClass', row.conclusionClassId);
      setSelect('fieldConclusionFramework', row.conclusionFrameworkId);
      setSelect('fieldConclusionLocation', row.conclusionLocationId);
      setSelect('fieldGradeLevel', row.gradeLevelId);
      setSelect('fieldClass', row.classId);
      document.getElementById('fieldNotes').value = row.notes || '';
      rowModal = rowModal || new bootstrap.Modal(document.getElementById('rowModal'));
      rowModal.show();
    }

    async function saveRow() {
      const form = document.getElementById('rowForm');
      const data = new FormData(form);
      const errDiv = document.getElementById('rowErrors');
      errDiv.style.display = 'none';

      const resp = await fetch(reportUrls.saveRow, { method: 'POST', body: data });
      const result = await resp.json();
      if (result.success) {
        location.reload();
      } else {
        errDiv.innerHTML = (result.errors || [result.error]).join('<br/>');
        errDiv.style.display = 'block';
      }
    }

    async function deleteRow(rowId) {
      if (!confirm('האם למחוק שורה זו?')) return;
      const token = document.querySelector('[name=__RequestVerificationToken]').value;
      const tr = document.querySelector('tr[data-row-id="' + rowId + '"]');
      const rv = tr ? (tr.getAttribute('data-row-version') || '') : '';
      const data = new FormData();
      data.append('rowId', rowId);
      data.append('rowVersion', rv);
      data.append('__RequestVerificationToken', token);
      const resp = await fetch(reportUrls.deleteRow, { method: 'POST', body: data });
      const result = await resp.json().catch(() => ({ success: false }));
      if (result.success) {
        location.reload();
      } else {
        alert(result.error || 'שגיאה במחיקת שורה');
      }
    }

    async function uploadAttachment() {
      const input = document.getElementById('report-file-upload');
      if (!input.files.length) return;
      const token = document.querySelector('[name=__RequestVerificationToken]').value;
      const data = new FormData();
      data.append('reportId', inlineReportId);
      data.append('file', input.files[0]);
      const descriptionInput = document.getElementById('report-file-description');
      data.append('description', descriptionInput ? descriptionInput.value : '');
      data.append('__RequestVerificationToken', token);
      const resp = await fetch(reportUrls.uploadAttachment, { method: 'POST', body: data });
      const result = await resp.json();
      if (result.success) location.reload();
      else alert(result.error || 'שגיאה בהעלאת מסמך');
    }

    async function deleteAttachment(attachmentId) {
      if (!confirm('האם למחוק מסמך זה?')) return;
      const token = document.querySelector('[name=__RequestVerificationToken]').value;
      const data = new FormData();
      data.append('attachmentId', attachmentId);
      data.append('__RequestVerificationToken', token);
      const resp = await fetch(reportUrls.deleteAttachment, { method: 'POST', body: data });
      const result = await resp.json();
      if (result.success) location.reload();
      else alert(result.error || 'שגיאה במחיקת מסמך');
    }

    document.addEventListener('DOMContentLoaded', function () {
      const editRowId = @(editRowId.HasValue ? editRowId.Value.ToString() : "0");
      if (editRowId > 0) {
        editRow(editRowId);
        const url = new URL(window.location.href);
        url.searchParams.delete('editRowId');
        window.history.replaceState({}, '', url);
      }
    });
  </script>
}
