@model List<AxiomaReporting.Core.Entities.ReportingMonth>
@{
  ViewData["Title"] = "ניהול חודשי דיווח";
}
<div class="container-fluid mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>חודשי דיווח — פעילות חודשית</h3>
    <div class="d-flex gap-2">
      <a asp-controller="Lookup" asp-action="Index" class="btn btn-outline-secondary btn-sm">חזרה לטבלאות עזר</a>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">הוסף חודש</button>
    </div>
  </div>

  @if (TempData["Success"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite" aria-atomic="true">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }
  @if (TempData["Error"] != null)
  {
    <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive" aria-atomic="true">
      @TempData["Error"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }

  <div class="alert alert-info">
    <strong>שים לב:</strong> רק חודש אחד יכול להיות פעיל בו-זמנית. הפעלת חודש תשבית אוטומטית את כל שאר החודשים.
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover table-bordered mb-0">
        <thead class="table-light">
          <tr>
            <th>תיאור</th>
            <th>חודש</th>
            <th>שנה</th>
            <th>תאריך אחרון לדיווח</th>
            <th>דיווח עתידי</th>
            <th>סטטוס</th>
            <th>פעולות</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Any())
          {
            <tr><td colspan="7" class="text-center text-muted py-4">אין חודשי דיווח</td></tr>
          }
          @foreach (var m in Model)
          {
            <tr class="@(m.IsActive ? "table-success" : "")">
              <td>@m.Description</td>
              <td>@m.Month</td>
              <td>@m.Year</td>
              <td>@m.LastReportingDate.ToString("dd/MM/yyyy")</td>
              <td>@(m.AllowFutureReporting ? "כן" : "לא")</td>
              <td>
                @if (m.IsActive)
                {
                  <span class="badge bg-success">פעיל</span>
                }
                else
                {
                  <span class="badge bg-secondary">לא פעיל</span>
                }
              </td>
              <td>
                <a asp-action="EditReportingMonth" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">ערוך</a>
                @if (!m.IsActive)
                {
                  <form asp-action="ActivateReportingMonth" asp-route-id="@m.Id" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success"
                            onclick="return confirm('להפעיל חודש זה? חודשים אחרים יושבתו.')">
                      הפעל
                    </button>
                  </form>
                }
                else
                {
                  <form asp-action="DeactivateReportingMonth" asp-route-id="@m.Id" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning">השבת</button>
                  </form>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalTitle" aria-hidden="true">
  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addModalTitle">הוסף חודש דיווח</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור חלון"></button>
      </div>
      <form asp-action="CreateReportingMonth" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">תיאור <span class="text-danger">*</span></label>
            <input name="description" class="form-control" required placeholder="לדוגמה: ינואר 2025" />
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label">חודש <span class="text-danger">*</span></label>
              <select name="month" class="form-select" required>
                @for (int i = 1; i <= 12; i++)
                {
                  <option value="@i">@i</option>
                }
              </select>
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">שנה <span class="text-danger">*</span></label>
              <input name="year" type="number" class="form-control" min="2020" max="2035"
                     value="@DateTime.Now.Year" required />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">תאריך אחרון לדיווח <span class="text-danger">*</span></label>
            <input name="lastReportingDate" type="date" class="form-control" required />
          </div>
          <div class="mb-3 form-check">
            <input name="allowFutureReporting" type="checkbox" class="form-check-input" id="allowFuture" value="true" />
            <label class="form-check-label" for="allowFuture">אפשר דיווח עתידי</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
          <button type="submit" class="btn btn-primary">שמור</button>
        </div>
      </form>
    </div>
  </div>
</div>
