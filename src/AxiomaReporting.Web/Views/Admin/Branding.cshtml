@{
  ViewData["Title"] = "לוגו המערכת";
  var currentLogoPath = (string)(ViewBag.CurrentLogoPath ?? "/images/logo.png");
}
<div class="container-fluid mt-3" dir="rtl">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>לוגו המערכת</h3>
    <a asp-controller="Admin" asp-action="SystemConstants" class="btn btn-outline-secondary btn-sm">חזרה לקבועי מערכת</a>
  </div>

  <p class="text-muted">הלוגו מוצג בדף הכניסה ובסרגל העליון של המערכת. ניתן להחליפו כאן ללא צורך בפריסה מחודשת.</p>

  <div class="card mb-3" aria-labelledby="brandingPreviewHeader">
    <div class="card-body">
      <h5 id="brandingPreviewHeader" class="card-title">תצוגה מקדימה של הלוגו הנוכחי</h5>
      <div class="branding-preview" role="img" aria-label="תצוגה מקדימה של הלוגו הפעיל">
        <img src="@currentLogoPath" alt="הלוגו הפעיל כעת" />
      </div>
      <p class="small text-muted mt-2 mb-0">נתיב נוכחי: <code>@currentLogoPath</code></p>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h5 class="card-title">העלאת לוגו חדש</h5>
      <form asp-action="UploadLogo" method="post" enctype="multipart/form-data"
            aria-label="טופס העלאת לוגו חדש" novalidate>
        @Html.AntiForgeryToken()
        <div class="mb-3">
          <label for="logoFile" class="form-label">קובץ לוגו</label>
          <input id="logoFile" name="logoFile" type="file"
                 accept=".png,.svg,.jpg,.jpeg"
                 class="form-control"
                 aria-describedby="logoFileHelp"
                 aria-required="true"
                 required />
          <div id="logoFileHelp" class="form-text">
            סוגי קבצים מותרים: PNG, SVG, JPG. גודל מקסימלי: 2 מ"ב. מומלץ יחס רוחב/גובה של כ-3:1 לתצוגה מיטבית בסרגל העליון.
          </div>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">העלה לוגו</button>
        </div>
      </form>
    </div>
  </div>

  <form asp-action="ResetLogo" method="post" class="mt-3"
        aria-label="טופס איפוס הלוגו לברירת מחדל"
        onsubmit="return confirm('האם לאפס את הלוגו לברירת המחדל?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary btn-sm">אפס לברירת מחדל</button>
  </form>
</div>
