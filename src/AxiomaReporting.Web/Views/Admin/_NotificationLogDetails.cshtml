@model AxiomaReporting.Core.Entities.NotificationLog
@using AxiomaReporting.Core.Interfaces
@inject IHtmlSanitizerService HtmlSanitizer
@{
  string TypeLabel(string? value) => value switch
  {
    "Report" => "דיווח",
    "Reminder" => "תזכורת",
    "Account" => "חשבון",
    "Excel" => "אקסל",
    "Other" => "אחר",
    _ => value ?? ""
  };
  string StatusLabel(string? value) => value switch
  {
    "Pending" => "ממתין",
    "Sent" => "נשלח",
    "Failed" => "נכשל",
    "Abandoned" => "ננטש",
    _ => value ?? ""
  };
  string TemplateLabel(string? value) => value switch
  {
    "ReportReceived" => "דיווח התקבל",
    "ReportApproved" => "דיווח אושר",
    "ReportRejected" => "דיווח הוחזר לתיקון",
    "ReminderNotSubmitted" => "תזכורת לדיווח שלא הוגש",
    "ReminderNeedsCorrection" => "תזכורת לדיווח לתיקון",
    "PasswordReset" => "איפוס סיסמה",
    "TwoFactorCode" => "קוד אימות",
    "PasswordExpiryWarning" => "אזהרת תפוגת סיסמה",
    "BatchImportSuccessUploader" => "קליטת קובץ מרוכז",
    "BatchImportErrors" => "שגיאות בקליטת קובץ",
    _ => value ?? ""
  };
}

<dl class="row mb-3">
  <dt class="col-sm-3">מזהה</dt>
  <dd class="col-sm-9">@Model.Id</dd>

  <dt class="col-sm-3">נוצר</dt>
  <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>

  <dt class="col-sm-3">סוג</dt>
  <dd class="col-sm-9">@TypeLabel(Model.NotificationType)</dd>

  <dt class="col-sm-3">תבנית</dt>
  <dd class="col-sm-9">@TemplateLabel(Model.TemplateType)</dd>

  <dt class="col-sm-3">נמען</dt>
  <dd class="col-sm-9">
    @Model.RecipientEmail
    @if (Model.RecipientUser != null)
    {
      <div class="text-muted small">@Model.RecipientUser.FirstName @Model.RecipientUser.LastName</div>
    }
  </dd>

  <dt class="col-sm-3">סטטוס</dt>
  <dd class="col-sm-9">@StatusLabel(Model.Status)</dd>

  <dt class="col-sm-3">ניסיונות</dt>
  <dd class="col-sm-9">@Model.AttemptCount</dd>

  @if (Model.LastAttemptAt.HasValue)
  {
    <dt class="col-sm-3">ניסיון אחרון</dt>
    <dd class="col-sm-9">@Model.LastAttemptAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</dd>
  }

  @if (Model.NextRetryAt.HasValue)
  {
    <dt class="col-sm-3">ניסיון הבא</dt>
    <dd class="col-sm-9">@Model.NextRetryAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</dd>
  }

  @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
  {
    <dt class="col-sm-3">שגיאה</dt>
    <dd class="col-sm-9"><code>@Model.FailureReason</code></dd>
  }
</dl>

<div class="mb-3">
  <h6>נושא</h6>
  <div class="border rounded p-2 bg-light">@Model.Subject</div>
</div>

<div class="mb-3">
  <h6>תוכן</h6>
  <div class="border rounded p-2 bg-light" style="max-height: 320px; overflow: auto;">
    @* Sanitized at render time: the body is composed from an admin-authored email
       template (now sanitized on save), but older logged emails may predate that
       fix. See CLAUDE.md security review finding C1. *@
    @Html.Raw(HtmlSanitizer.Sanitize(Model.Body))
  </div>
</div>
