@model List<AxiomaReporting.Core.Entities.Framework>
@{
  ViewData["Title"] = "ניהול מסגרות";
  var educationalStages = ViewBag.EducationalStages as List<AxiomaReporting.Core.Entities.EducationalStage> ?? new();
  string? fName = ViewBag.FilterName as string;
  string? fSymbol = ViewBag.FilterSymbol as string;
  int? fStageId = ViewBag.FilterStageId as int?;
  string? fLocality = ViewBag.FilterLocality as string;
  bool? fIsActive = ViewBag.FilterIsActive as bool?;
  var localityBySymbol = ViewBag.LocalityBySymbol as Dictionary<string, string> ?? new();
  int page = ViewBag.Page ?? 1;
  int pageSize = ViewBag.PageSize ?? 50;
  int totalCount = ViewBag.TotalCount ?? Model.Count;
  int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
  object FilterRoute(int p) => new { name = fName, symbol = fSymbol, stageId = fStageId, locality = fLocality, isActive = fIsActive, page = p, pageSize };
}
<div class="container-fluid mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>מסגרות</h3>
    <div class="d-flex gap-2">
      <a asp-controller="Lookup" asp-action="Index" class="btn btn-outline-secondary btn-sm">חזרה לטבלאות עזר</a>
      <a asp-action="ExportFrameworksExcel" asp-route-name="@fName" asp-route-symbol="@fSymbol"
         asp-route-stageId="@fStageId" asp-route-locality="@fLocality"
         class="btn btn-success btn-sm">ייצוא לאקסל</a>
      <a asp-action="DataMigration" class="btn btn-outline-primary btn-sm" title="ייבוא מסגרות מקובץ אקסל">ייבוא אקסל</a>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">הוסף מסגרת</button>
    </div>
  </div>

  @* הבהרה למשוב הלקוח B28: ההבדל בין מוסדות למסגרות *@
  <p class="text-muted small">
    <strong>מסגרות</strong> = הרשימה המשמשת לדיווח (רשומה אחת לכל צירוף סמל מוסד + שלב חינוך).
    <strong>מוסדות</strong> = מאגר המוסדות המלא שממנו נגזרות המסגרות, כולל יישוב, מחוז ומגזר.
  </p>

  @* סרגל חיפוש (משוב בטא B29/B34): שם מסגרת, סמל, שלב חינוך, יישוב *@
  <form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label" for="fw-name">שם מסגרת</label>
        <input id="fw-name" name="name" value="@fName" class="form-control form-control-sm" />
      </div>
      <div class="col-md-2">
        <label class="form-label" for="fw-symbol">סמל מסגרת</label>
        <input id="fw-symbol" name="symbol" value="@fSymbol" class="form-control form-control-sm" />
      </div>
      <div class="col-md-2">
        <label class="form-label" for="fw-stage">שלב חינוך</label>
        <select id="fw-stage" name="stageId" class="form-select form-select-sm" data-no-choices="1">
          <option value="">-- הכל --</option>
          @foreach (var s in educationalStages)
          {
            <option value="@s.Id" selected="@(fStageId == s.Id)">@s.Description</option>
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="fw-locality">יישוב</label>
        <input id="fw-locality" name="locality" value="@fLocality" class="form-control form-control-sm" />
      </div>
      <div class="col-md-2">
        <label class="form-label" for="fw-status">סטטוס</label>
        <select id="fw-status" name="isActive" class="form-select form-select-sm" data-no-choices="1">
          <option value="">-- הכל --</option>
          <option value="true" selected="@(fIsActive == true)">פעיל</option>
          <option value="false" selected="@(fIsActive == false)">לא פעיל</option>
        </select>
      </div>
      <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm">חפש</button>
        <a asp-action="Frameworks" class="btn btn-outline-secondary btn-sm">נקה</a>
      </div>
    </div>
  </form>

  @* פעולה גורפת: הפיכת כל המסגרות בסינון לפעיל / לא פעיל (משוב בטא B30) *@
  <div class="d-flex gap-2 mb-3 align-items-center">
    <span class="text-muted small">נמצאו @totalCount מסגרות בסינון —</span>
    <form asp-action="BulkSetFrameworksActive" method="post" class="d-inline"
          onsubmit="return confirm('להפוך את כל המסגרות בסינון הנוכחי לפעילות?')">
      @Html.AntiForgeryToken()
      <input type="hidden" name="isActive" value="true" />
      <input type="hidden" name="name" value="@fName" />
      <input type="hidden" name="symbol" value="@fSymbol" />
      <input type="hidden" name="stageId" value="@fStageId" />
      <input type="hidden" name="locality" value="@fLocality" />
      <input type="hidden" name="filterIsActive" value="@fIsActive" />
      <button type="submit" class="btn btn-outline-success btn-sm">הפוך לפעיל (מסוננים)</button>
    </form>
    <form asp-action="BulkSetFrameworksActive" method="post" class="d-inline"
          onsubmit="return confirm('להפוך את כל המסגרות בסינון הנוכחי ללא פעילות?')">
      @Html.AntiForgeryToken()
      <input type="hidden" name="isActive" value="false" />
      <input type="hidden" name="name" value="@fName" />
      <input type="hidden" name="symbol" value="@fSymbol" />
      <input type="hidden" name="stageId" value="@fStageId" />
      <input type="hidden" name="locality" value="@fLocality" />
      <input type="hidden" name="filterIsActive" value="@fIsActive" />
      <button type="submit" class="btn btn-outline-danger btn-sm">הפוך ללא פעיל (מסוננים)</button>
    </form>
  </div>

  @if (TempData["Success"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite" aria-atomic="true">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }
  @if (TempData["Error"] != null)
  {
    <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive" aria-atomic="true">
      @TempData["Error"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover table-bordered mb-0">
        <thead class="table-light">
          <tr>
            <th>תיאור</th>
            <th>סמל מוסד</th>
            <th>יישוב</th>
            <th>שלב חינוך</th>
            <th>פעיל</th>
            <th>פעולות</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Any())
          {
            <tr><td colspan="6" class="text-center text-muted py-4">אין מסגרות</td></tr>
          }
          @foreach (var f in Model)
          {
            <tr>
              <td>@f.Description</td>
              <td>@f.InstitutionSymbol</td>
              <td>@(localityBySymbol.TryGetValue(f.InstitutionSymbol, out var loc) ? loc : "—")</td>
              <td>@(f.EducationalStage?.Description ?? "—")</td>
              <td>
                @if (f.IsActive)
                {
                  <span class="badge bg-success">כן</span>
                }
                else
                {
                  <span class="badge bg-secondary">לא</span>
                }
              </td>
              <td>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-edit"
                        data-id="@f.Id"
                        data-description="@f.Description"
                        data-symbol="@f.InstitutionSymbol"
                        data-stage="@(f.EducationalStageId?.ToString() ?? "")"
                        data-active="@f.IsActive.ToString().ToLower()">
                  ✏️
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  @if (totalPages > 1)
  {
    <nav aria-label="ניווט עמודים" class="mt-3">
      <ul class="pagination pagination-sm justify-content-center">
        @for (var p = 1; p <= totalPages; p++)
        {
          <li class="page-item @(p == page ? "active" : "")">
            <a class="page-link" asp-action="Frameworks" asp-all-route-data="@(new Dictionary<string,string>{["name"]=fName??"",["symbol"]=fSymbol??"",["stageId"]=fStageId?.ToString()??"",["locality"]=fLocality??"",["page"]=p.ToString(),["pageSize"]=pageSize.ToString()})">@p</a>
          </li>
        }
      </ul>
    </nav>
  }
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalTitle" aria-hidden="true">
  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addModalTitle">הוסף מסגרת</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור חלון"></button>
      </div>
      <form asp-action="CreateFramework" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">תיאור <span class="text-danger">*</span></label>
            <input name="description" class="form-control" required maxlength="200" />
          </div>
          <div class="mb-3">
            <label class="form-label">סמל מוסד <span class="text-danger">*</span></label>
            <input name="institutionSymbol" class="form-control" required maxlength="50" />
          </div>
          <div class="mb-3">
            <label class="form-label">שלב חינוך</label>
            <select name="educationalStageId" class="form-select">
              <option value="">— בחר —</option>
              @foreach (var stage in educationalStages)
              {
                <option value="@stage.Id">@stage.Description</option>
              }
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
          <button type="submit" class="btn btn-primary">שמור</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalTitle" aria-hidden="true">
  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editModalTitle">עדכון מסגרת</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור חלון"></button>
      </div>
      <form id="editForm" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">תיאור <span class="text-danger">*</span></label>
            <input id="editDescription" name="description" class="form-control" required maxlength="200" />
          </div>
          <div class="mb-3">
            <label class="form-label">סמל מוסד <span class="text-danger">*</span></label>
            <input id="editSymbol" name="institutionSymbol" class="form-control" required maxlength="50" />
          </div>
          <div class="mb-3">
            <label class="form-label">שלב חינוך</label>
            <select id="editStage" name="educationalStageId" class="form-select">
              <option value="">— בחר —</option>
              @foreach (var stage in educationalStages)
              {
                <option value="@stage.Id">@stage.Description</option>
              }
            </select>
          </div>
          <div class="mb-3 form-check">
            <input id="editIsActive" name="isActive" type="checkbox" class="form-check-input" value="true" />
            <label class="form-check-label" for="editIsActive">פעיל</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
          <button type="submit" class="btn btn-primary">שמור</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.btn-edit').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById('editDescription').value = btn.getAttribute('data-description');
      document.getElementById('editSymbol').value = btn.getAttribute('data-symbol');
      document.getElementById('editIsActive').checked = btn.getAttribute('data-active') === 'true';
      var stageVal = btn.getAttribute('data-stage');
      document.getElementById('editStage').value = stageVal || '';
      document.getElementById('editForm').action = '/Admin/EditFramework/' + btn.getAttribute('data-id');
      new bootstrap.Modal(document.getElementById('editModal')).show();
    });
  });
</script>
