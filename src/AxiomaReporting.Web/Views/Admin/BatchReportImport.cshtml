@model AxiomaReporting.Web.Models.BatchReportImportFormViewModel
@{
  ViewData["Title"] = "ייבוא דיווחים מרוכז";
}

<div class="container mt-3" dir="rtl">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>ייבוא דיווחים מרוכז — קובץ רב-עובדים</h3>
    <a asp-action="DataMigration" class="btn btn-outline-secondary btn-sm">חזרה</a>
  </div>

  @if (TempData["Error"] != null)
  {
    <div class="alert alert-danger" role="alert" aria-live="assertive">@TempData["Error"]</div>
  }

  <div class="alert alert-info">
    <strong>כלי זה מיועד למנהל מערכת ולמנהל פרויקט בלבד.</strong>
    <ul class="mb-0 mt-2 small">
      <li>קובץ אקסל (xlsx) יחיד המכיל דיווחים של מספר עובדים.</li>
      <li>שורת כותרת מזוהה אוטומטית לפי הכותרת "קוד עובד".</li>
      <li>לכל שורה תקינה תיקלט פעילות חודשית לעובד המתאים, וההודעה "דיווח התקבל" תישלח לכתובת הדוא"ל שלו.</li>
      <li>שורות שגויות לא תיקלטנה. רשימת השגיאות תוצג על המסך וניתנת להורדה כ-Excel.</li>
    </ul>
  </div>

  <div class="card">
    <div class="card-body">
      <form asp-action="BatchReportImport" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
          <label for="reportingMonthId" class="form-label">חודש דיווח</label>
          <select name="reportingMonthId" id="reportingMonthId" class="form-select" required>
            @foreach (var m in Model.ReportingMonths)
            {
              var label = $"{m.Description} ({m.Month}/{m.Year})" + (m.IsActive ? " — פעיל" : "");
              if (Model.SelectedReportingMonthId == m.Id)
              {
                <option value="@m.Id" selected>@label</option>
              }
              else
              {
                <option value="@m.Id">@label</option>
              }
            }
          </select>
        </div>
        <div class="mb-3">
          <label for="file" class="form-label">קובץ אקסל (xlsx)</label>
          <input type="file" id="file" name="file" accept=".xlsx" class="form-control" required />
        </div>
        <div id="batchImportProgressBox" class="d-none mb-3" aria-live="polite">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span id="batchImportProgressText" class="small text-muted">מכין ייבוא...</span>
            <span id="batchImportProgressPercent" class="small fw-semibold">0%</span>
          </div>
          <div class="progress" style="height: 1rem;">
            <div id="batchImportProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">ייבא דיווחים</button>
      </form>
    </div>
  </div>
</div>
<script>
(function () {
  const form = document.querySelector('form[method="post"]');
  if (!form) return;
  const box = document.getElementById('batchImportProgressBox');
  const bar = document.getElementById('batchImportProgressBar');
  const text = document.getElementById('batchImportProgressText');
  const percent = document.getElementById('batchImportProgressPercent');
  const button = form.querySelector('button[type="submit"]');
  function setProgress(value, label) {
    const safeValue = Math.max(0, Math.min(100, Number(value) || 0));
    bar.style.width = safeValue + '%';
    bar.setAttribute('aria-valuenow', String(safeValue));
    percent.textContent = safeValue + '%';
    if (label) text.textContent = label;
  }
  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const progressId = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now().toString(36) + Math.random().toString(36).slice(2));
    let progressInput = form.querySelector('input[name="progressId"]');
    if (!progressInput) {
      progressInput = document.createElement('input');
      progressInput.type = 'hidden';
      progressInput.name = 'progressId';
      form.appendChild(progressInput);
    }
    progressInput.value = progressId;
    box.classList.remove('d-none');
    button.disabled = true;
    button.textContent = 'מייבא...';
    setProgress(1, 'מעלה קובץ ומתחיל ייבוא...');
    const poll = window.setInterval(async function () {
      try {
        const response = await fetch('/Admin/BatchReportImportProgress?id=' + encodeURIComponent(progressId), { cache: 'no-store' });
        if (!response.ok) return;
        const progress = await response.json();
        const processed = progress.processedRows || progress.ProcessedRows || 0;
        const total = progress.totalRows || progress.TotalRows || 0;
        const progressPercent = progress.percent || progress.Percent || 0;
        const label = total > 0 ? ('מעבד שורה ' + processed + ' מתוך ' + total) : 'מעבד קובץ...';
        setProgress(progressPercent, label);
      } catch (error) {
      }
    }, 700);
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
      const html = await response.text();
      window.clearInterval(poll);
      setProgress(100, 'הייבוא הסתיים, טוען תוצאות...');
      document.open();
      document.write(html);
      document.close();
    } catch (error) {
      window.clearInterval(poll);
      button.disabled = false;
      button.textContent = 'ייבא דיווחים';
      setProgress(0, 'אירעה שגיאה בייבוא. נסה שוב.');
    }
  });
})();
</script>
