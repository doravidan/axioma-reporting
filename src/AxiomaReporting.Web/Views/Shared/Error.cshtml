@model ErrorViewModel
@{
    ViewData["Title"] = "שגיאה";
}

<div class="alert alert-danger mt-3" role="alert" aria-live="assertive">
  <h1 class="h4 mb-2">אירעה שגיאה</h1>
  <p class="mb-0">לא ניתן להשלים את הפעולה כרגע. אם הבעיה חוזרת, יש לפנות למנהל המערכת.</p>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted">
        <strong>מזהה בקשה:</strong> <code>@Model.RequestId</code>
    </p>
}
