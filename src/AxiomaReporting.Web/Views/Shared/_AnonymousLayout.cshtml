<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - סייט אנד סאונד</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/lib/choices.js/choices.min.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/AxiomaReporting.Web.styles.css" asp-append-version="true" />
</head>
<body class="anonymous-page">
  <a href="#main-content" class="skip-link">דלג לתוכן הראשי</a>
  <div class="container">
    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success alert-dismissible fade show mt-3" role="alert" aria-live="polite" aria-atomic="true">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
      </div>
    }
    @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" aria-live="assertive" aria-atomic="true">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
      </div>
    }
    <main id="main-content" role="main" class="pb-3">
      @RenderBody()
    </main>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation/dist/localization/messages_he.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
  <script src="~/lib/choices.js/choices.min.js" asp-append-version="true"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
  <script>
    // Choices.js global init — same IIFE as in _Layout.cshtml so login + reset
    // pages also get tag-style multi-selects without requiring site.js order.
    (function () {
      if (typeof window.Choices === 'undefined') { return; }
      document.querySelectorAll('select[multiple]').forEach(function (el) {
        if (el.dataset.choicesInit) { return; }
        try {
          new window.Choices(el, {
            removeItemButton: true,
            searchPlaceholderValue: 'חיפוש…',
            noResultsText: 'לא נמצאו תוצאות',
            shouldSort: false,
            itemSelectText: ''
          });
          el.dataset.choicesInit = '1';
        } catch (e) { /* swallow — fallback to native widget */ }
      });
    })();
  </script>
</body>
</html>
