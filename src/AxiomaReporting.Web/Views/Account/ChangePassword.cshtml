@model AxiomaReporting.Core.DTOs.ChangePasswordDto
@{
  ViewData["Title"] = "שינוי סיסמה";
  bool forced = ViewBag.Forced ?? false;
}
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h4>@(forced ? "נדרש שינוי סיסמה" : "שינוי סיסמה")</h4>
          @if (forced)
          {
            <p class="text-muted mb-0">עליך לשנות את סיסמתך לפני המשך השימוש במערכת.</p>
          }
        </div>
        <div class="card-body">
          @if (!ViewData.ModelState.IsValid)
          {
            <div class="alert alert-danger" role="alert" aria-live="assertive" aria-atomic="true">
              @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
              {
                <div>@error.ErrorMessage</div>
              }
            </div>
          }
          <form asp-action="ChangePassword" asp-route-forced="@forced" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label asp-for="CurrentPassword" class="form-label">סיסמה נוכחית</label>
              <input asp-for="CurrentPassword" type="password" class="form-control" />
            </div>
            <div class="mb-3">
              <label asp-for="NewPassword" class="form-label">סיסמה חדשה (מינימום 8 תווים, אותיות וספרות)</label>
              <input asp-for="NewPassword" type="password" class="form-control" />
            </div>
            <div class="mb-3">
              <label asp-for="ConfirmPassword" class="form-label">אישור סיסמה חדשה</label>
              <input asp-for="ConfirmPassword" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">שמור סיסמה</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
