@{
  ViewData["Title"] = "שחזור סיסמה";
}
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header"><h4>שחזור סיסמה</h4></div>
        <div class="card-body">
          <p>הזן את מספר תעודת הזהות שלך. ישלח אליך קישור לאיפוס סיסמה.</p>
          <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label class="form-label">תעודת זהות</label>
              <input type="text" class="form-control" name="idNumber" required />
            </div>
            <button type="submit" class="btn btn-primary">שלח קישור</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
