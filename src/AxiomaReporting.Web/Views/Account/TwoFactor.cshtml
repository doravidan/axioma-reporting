@{
  ViewData["Title"] = "אימות דו-שלבי";
}

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header"><h4>אימות דו-שלבי</h4></div>
        <div class="card-body">
          <p>קוד אימות נשלח לכתובת המייל שלך. הזן את הקוד כדי להשלים כניסה.</p>
          @if (!ViewData.ModelState.IsValid)
          {
            <div class="alert alert-danger" role="alert" aria-live="assertive" aria-atomic="true">
              @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
              {
                <div>@error.ErrorMessage</div>
              }
            </div>
          }
          <form asp-action="TwoFactor" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label class="form-label">קוד אימות</label>
              <input name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" required />
            </div>
            <button type="submit" class="btn btn-primary">אימות וכניסה</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
