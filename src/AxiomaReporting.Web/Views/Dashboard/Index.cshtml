@using AxiomaReporting.Infrastructure.Services
@using AxiomaReporting.Core.Entities
@{
    ViewData["Title"] = "דשבורד דיווחים";
    var filter = ViewBag.Filter as DashboardFilter ?? new DashboardFilter();
    var rows = ViewBag.Rows as List<DashboardReportDetailRow> ?? new List<DashboardReportDetailRow>();
    var districts = ViewBag.Districts as List<District> ?? new List<District>();
    var sectors = ViewBag.Sectors as List<Sector> ?? new List<Sector>();
    var programs = ViewBag.Programs as List<AxiomaReporting.Core.Entities.Program> ?? new List<AxiomaReporting.Core.Entities.Program>();
    var reportingMonths = ViewBag.ReportingMonths as List<ReportingMonth> ?? new List<ReportingMonth>();
    var localities = ViewBag.Localities as List<Locality> ?? new List<Locality>();
    var frameworks = ViewBag.Frameworks as List<Framework> ?? new List<Framework>();
    var educationalPrograms = ViewBag.EducationalPrograms as List<EducationalProgram> ?? new List<EducationalProgram>();
    var domains = ViewBag.Domains as List<Domain> ?? new List<Domain>();
    var subjects = ViewBag.Subjects as List<Subject> ?? new List<Subject>();
    var discussionCodes = ViewBag.DiscussionCodes as List<DiscussionCode> ?? new List<DiscussionCode>();
    var classes = ViewBag.Classes as List<SchoolClass> ?? new List<SchoolClass>();
    var gradeLevels = ViewBag.GradeLevels as List<GradeLevel> ?? new List<GradeLevel>();
    var conclusionLocations = ViewBag.ConclusionLocations as List<LocalityDistrictNational> ?? new List<LocalityDistrictNational>();
    var reportTypes = ViewBag.ReportTypes as List<ReportType> ?? new List<ReportType>();
    int total = ViewBag.TotalCount ?? 0;

    Dictionary<string, object?> RouteValues(int page, string? sortBy = null) => new()
    {
        ["show"] = 1,
        ["Page"] = page,
        ["PageSize"] = filter.PageSize,
        ["StatusId"] = filter.StatusId,
        ["DistrictId"] = filter.DistrictId,
        ["SectorId"] = filter.SectorId,
        ["ProgramId"] = filter.ProgramId,
        ["LocalityId"] = filter.LocalityId,
        ["FrameworkId"] = filter.FrameworkId,
        ["EducationalProgramId"] = filter.EducationalProgramId,
        ["DomainId"] = filter.DomainId,
        ["Subject1Id"] = filter.Subject1Id,
        ["Subject2Id"] = filter.Subject2Id,
        ["DiscussionCodeId"] = filter.DiscussionCodeId,
        ["ClassId"] = filter.ClassId,
        ["GradeLevelId"] = filter.GradeLevelId,
        ["ConclusionClassId"] = filter.ConclusionClassId,
        ["ConclusionFrameworkId"] = filter.ConclusionFrameworkId,
        ["ConclusionLocationId"] = filter.ConclusionLocationId,
        ["ReportTypeId"] = filter.ReportTypeId,
        ["MeetingDateFrom"] = filter.MeetingDateFrom?.ToString("yyyy-MM-dd"),
        ["MeetingDateTo"] = filter.MeetingDateTo?.ToString("yyyy-MM-dd"),
        ["MeetingDuration"] = filter.MeetingDuration,
        ["EmployeeCode"] = filter.EmployeeCode,
        ["IdNumber"] = filter.IdNumber,
        ["EmployeeName"] = filter.EmployeeName,
        ["FromMonthId"] = filter.FromMonthId,
        ["ToMonthId"] = filter.ToMonthId,
        ["SortBy"] = sortBy ?? filter.SortBy,
        ["SortDesc"] = sortBy == null ? filter.SortDesc : filter.SortBy == sortBy ? !filter.SortDesc : false
    };

    string SortLink(string key) => Url.Action("Index", RouteValues(1, key)) ?? "#";
    string AriaSort(string key) => filter.SortBy == key ? (filter.SortDesc ? "descending" : "ascending") : "none";
    string TextOrDash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string DateOrDash(DashboardReportDetailRow row) => row.StatusId == 0 || row.MeetingDate == DateTime.MinValue
        ? "—"
        : row.MeetingDate.ToString("dd/MM/yyyy");
    bool showEditColumn = ViewBag.CanEditDashboardRows ?? false;
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>דשבורד דיווחים</h3>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ExportExcel", RouteValues(1))" class="btn btn-outline-success btn-sm">ייצוא אקסל</a>
            <a asp-action="Summary" class="btn btn-primary btn-sm">מסך סיכום ואישור</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header"><strong>סינון דיווחים</strong></div>
        <div class="card-body">
            <form method="get" id="filterForm">
                <input type="hidden" name="show" value="1" />
                <input type="hidden" name="SortBy" value="@filter.SortBy" />
                <input type="hidden" name="SortDesc" value="@filter.SortDesc" />
                @if (User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3"))
                {
                    <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="IncludeArchived" value="true" id="includeArchived"@{if (filter.IncludeArchived){<text> checked</text>}} /><label class="form-check-label" for="includeArchived">הצג דיווחים בארכיון</label></div>
                }
                <div class="row g-2">
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">ת.ז</label>
                        <input name="IdNumber" class="form-control form-control-sm" value="@filter.IdNumber" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">קוד עובד</label>
                        <input name="EmployeeCode" class="form-control form-control-sm" value="@filter.EmployeeCode" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">שם מדווח</label>
                        <input name="EmployeeName" class="form-control form-control-sm" value="@filter.EmployeeName" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">מחודש</label>
                        <select name="FromMonthId" class="form-select form-select-sm">
                            <option value="">הכל</option>
                            @foreach (var m in reportingMonths) { <option value="@m.Id" selected="@(filter.FromMonthId == m.Id ? "selected" : null)">@m.Description</option> }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">עד חודש</label>
                        <select name="ToMonthId" class="form-select form-select-sm">
                            <option value="">הכל</option>
                            @foreach (var m in reportingMonths) { <option value="@m.Id" selected="@(filter.ToMonthId == m.Id ? "selected" : null)">@m.Description</option> }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">סטטוס</label>
                        <select name="StatusId" class="form-select form-select-sm">
                            <option value="">הכל</option>
                            <option value="0" selected="@(filter.StatusId == 0 ? "selected" : null)">טרם דווח</option>
                            <option value="1" selected="@(filter.StatusId == 1 ? "selected" : null)">טיוטה</option>
                            <option value="2" selected="@(filter.StatusId == 2 ? "selected" : null)">בהזנה</option>
                            <option value="3" selected="@(filter.StatusId == 3 ? "selected" : null)">ממתין לאישור</option>
                            <option value="4" selected="@(filter.StatusId == 4 ? "selected" : null)">מאושר</option>
                            <option value="5" selected="@(filter.StatusId == 5 ? "selected" : null)">הוחזר לתיקון</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">מתאריך</label>
                        <input name="MeetingDateFrom" type="date" class="form-control form-control-sm" value="@filter.MeetingDateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">עד תאריך</label>
                        <input name="MeetingDateTo" type="date" class="form-control form-control-sm" value="@filter.MeetingDateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm">משך מפגש</label>
                        <input name="MeetingDuration" type="number" step="0.5" min="0" class="form-control form-control-sm" value="@filter.MeetingDuration" />
                    </div>

                    <div class="col-md-1"><label class="form-label form-label-sm">מחוז</label><select name="DistrictId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in districts) { <option value="@x.Id" selected="@(filter.DistrictId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">מגזר</label><select name="SectorId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in sectors) { <option value="@x.Id" selected="@(filter.SectorId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">תוכנית</label><select name="ProgramId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in programs) { <option value="@x.Id" selected="@(filter.ProgramId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">יישוב</label><select name="LocalityId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in localities) { <option value="@x.Id" selected="@(filter.LocalityId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-2"><label class="form-label form-label-sm">מסגרת חינוכית</label><select name="FrameworkId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in frameworks) { <option value="@x.Id" selected="@(filter.FrameworkId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-2"><label class="form-label form-label-sm">תוכנית חינוכית</label><select name="EducationalProgramId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in educationalPrograms) { <option value="@x.Id" selected="@(filter.EducationalProgramId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">תחום</label><select name="DomainId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in domains) { <option value="@x.Id" selected="@(filter.DomainId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">נושא 1</label><select name="Subject1Id" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in subjects) { <option value="@x.Id" selected="@(filter.Subject1Id == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">נושא 2</label><select name="Subject2Id" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in subjects) { <option value="@x.Id" selected="@(filter.Subject2Id == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">קיום דיון</label><select name="DiscussionCodeId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in discussionCodes) { <option value="@x.Id" selected="@(filter.DiscussionCodeId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">כיתה</label><select name="ClassId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in classes) { <option value="@x.Id" selected="@(filter.ClassId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">שכבה</label><select name="GradeLevelId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in gradeLevels) { <option value="@x.Id" selected="@(filter.GradeLevelId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">סוג דיווח</label><select name="ReportTypeId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in reportTypes) { <option value="@x.Id" selected="@(filter.ReportTypeId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">מסקנה - כיתה</label><select name="ConclusionClassId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in classes) { <option value="@x.Id" selected="@(filter.ConclusionClassId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-2"><label class="form-label form-label-sm">מסקנה - מסגרת</label><select name="ConclusionFrameworkId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in frameworks) { <option value="@x.Id" selected="@(filter.ConclusionFrameworkId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-2"><label class="form-label form-label-sm">מסקנה - יישוב/מחוז/ארצי</label><select name="ConclusionLocationId" class="form-select form-select-sm"><option value="">הכל</option>@foreach (var x in conclusionLocations) { <option value="@x.Id" selected="@(filter.ConclusionLocationId == x.Id ? "selected" : null)">@x.Description</option> }</select></div>
                    <div class="col-md-1"><label class="form-label form-label-sm">שורות בעמוד</label><select name="PageSize" class="form-select form-select-sm">@foreach (var s in new[] { 10, 25, 50, 100 }) { <option value="@s" selected="@(filter.PageSize == s ? "selected" : null)">@s</option> }</select></div>

                    <div class="col-auto d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">הצג</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">נקה</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="text-muted mb-0">נמצאו <strong>@total</strong> שורות דיווח</p>
        @if (total > filter.PageSize)
        {
            var totalPages = (int)Math.Ceiling((double)total / filter.PageSize);
            <nav aria-label="דפדוף תוצאות">
                <ul class="pagination pagination-sm mb-0">
                    @for (var pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == filter.Page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", RouteValues(pg))">@pg</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered table-sm align-middle text-nowrap">
            <thead class="table-light">
                <tr>
                    @if (showEditColumn)
                    {
                        <th scope="col">פעולות</th>
                    }
                    <th scope="col" aria-sort="@AriaSort("sequence")"><a class="link-dark" href="@SortLink("sequence")">מס"ד</a></th>
                    <th scope="col" aria-sort="@AriaSort("idnumber")"><a class="link-dark" href="@SortLink("idnumber")">ת.ז</a></th>
                    <th scope="col" aria-sort="@AriaSort("code")"><a class="link-dark" href="@SortLink("code")">קוד עובד</a></th>
                    <th scope="col" aria-sort="@AriaSort("name")"><a class="link-dark" href="@SortLink("name")">שם מדווח</a></th>
                    <th scope="col" aria-sort="@AriaSort("month")"><a class="link-dark" href="@SortLink("month")">חודש דיווח</a></th>
                    <th scope="col">פרויקט</th>
                    <th scope="col" aria-sort="@AriaSort("district")"><a class="link-dark" href="@SortLink("district")">מחוז</a></th>
                    <th scope="col" aria-sort="@AriaSort("locality")"><a class="link-dark" href="@SortLink("locality")">יישוב</a></th>
                    <th scope="col" aria-sort="@AriaSort("framework")"><a class="link-dark" href="@SortLink("framework")">מסגרת חינוכית</a></th>
                    <th scope="col" aria-sort="@AriaSort("meetingdate")"><a class="link-dark" href="@SortLink("meetingdate")">תאריך מפגש</a></th>
                    <th scope="col" aria-sort="@AriaSort("duration")"><a class="link-dark" href="@SortLink("duration")">משך מפגש</a></th>
                    <th scope="col" aria-sort="@AriaSort("program")"><a class="link-dark" href="@SortLink("program")">תוכנית חינוכית</a></th>
                    <th scope="col">תחום</th>
                    <th scope="col">נושא 1</th>
                    <th scope="col">נושא 2</th>
                    <th scope="col">קיום דיון</th>
                    <th scope="col">כיתה</th>
                    <th scope="col">שכבה</th>
                    <th scope="col">סוג דיווח</th>
                    <th scope="col">מסקנה - כיתה</th>
                    <th scope="col">מסקנה - מסגרת</th>
                    <th scope="col">מסקנה - יישוב/מחוז/ארצי</th>
                    <th scope="col">מסמכים</th>
                    <th scope="col">הערות</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="@(showEditColumn ? 25 : 24)" class="text-center text-muted py-4">
                            לא נמצאו שורות דיווח התואמות את הסינון
                        </td>
                    </tr>
                }
                @foreach (var r in rows)
                {
                    <tr>
                        @if (showEditColumn)
                        {
                            <td>
                                @if (r.ReportId > 0 && r.ReportRowId > 0)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Report"
                                       asp-action="Index"
                                       asp-route-userId="@r.UserId"
                                       asp-route-allocationId="@r.AllocationId"
                                       asp-route-reportId="@r.ReportId"
                                       asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"
                                       asp-route-editRowId="@r.ReportRowId">ערוך</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                        <td>@(r.SequenceNumber == 0 ? "—" : r.SequenceNumber)</td>
                        <td>@r.IdNumber</td>
                        <td>@r.EmployeeCode</td>
                        <td>@r.FullName</td>
                        <td>@r.MonthDescription</td>
                        <td>@TextOrDash(r.ProjectName)</td>
                        <td>@TextOrDash(r.DistrictName)</td>
                        <td>@TextOrDash(r.LocalityName)</td>
                        <td>@TextOrDash(r.FrameworkName)</td>
                        <td>@DateOrDash(r)</td>
                        <td>@(r.StatusId == 0 ? "—" : r.MeetingDuration)</td>
                        <td>@TextOrDash(r.EducationalProgramName)</td>
                        <td>@TextOrDash(r.DomainName)</td>
                        <td>@TextOrDash(r.Subject1Name)</td>
                        <td>@TextOrDash(r.Subject2Name)</td>
                        <td>@TextOrDash(r.DiscussionCodeName)</td>
                        <td>@TextOrDash(r.ClassName)</td>
                        <td>@TextOrDash(r.GradeLevelName)</td>
                        <td>@TextOrDash(r.ReportTypeName)</td>
                        <td>@TextOrDash(r.ConclusionClassName)</td>
                        <td>@TextOrDash(r.ConclusionFrameworkName)</td>
                        <td>@TextOrDash(r.ConclusionLocationName)</td>
                        <td class="text-center">@(r.HasAttachments ? "כן" : "לא")</td>
                        <td class="text-wrap" style="min-width: 220px">@TextOrDash(r.Notes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-4 mt-2 text-muted">
        <span>סה"כ שורות בעמוד: <strong>@rows.Count</strong></span>
        <span>סה"כ שעות בעמוד: <strong>@rows.Where(r => r.StatusId != 0).Sum(r => r.MeetingDuration)</strong></span>
    </div>
</div>
