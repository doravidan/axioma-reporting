@model List<AxiomaReporting.Core.Entities.Base.LookupEntity>
@using System.Text.Json
@using AxiomaReporting.Core.Entities
@{
  ViewData["Title"] = $"ניהול {ViewBag.DisplayName}";
  bool isAdmin = ViewBag.IsAdmin ?? false;
  string tableName = ViewBag.TableName;
  int page = ViewBag.Page;
  int pageSize = ViewBag.PageSize;
  int total = ViewBag.TotalItems;
  int totalPages = (int)Math.Ceiling((double)total / pageSize);
  bool isLocalities = string.Equals(tableName, "localities", StringComparison.OrdinalIgnoreCase);
}
<div class="container-fluid mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewBag.DisplayName</h3>
    <div class="d-flex gap-2">
      <a asp-action="Index" class="btn btn-outline-secondary btn-sm">חזרה לרשימה</a>
      @if (isAdmin)
      {
        <button class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">
          ייבוא אקסל
        </button>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
          הוסף רשומה
        </button>
      }
    </div>
  </div>

  @if (TempData["Success"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite" aria-atomic="true">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }
  @if (TempData["Error"] != null)
  {
    <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive" aria-atomic="true">
      @TempData["Error"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }

  <form method="get" class="mb-3 d-flex gap-2 align-items-center flex-wrap">
    <input name="tableName" type="hidden" value="@tableName" />
    <input name="search" type="text" class="form-control" style="max-width:300px"
           placeholder="חיפוש לפי תיאור..." value="@ViewBag.Search" />
    <button type="submit" class="btn btn-outline-primary">חפש</button>
    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
    {
      <a asp-action="List" asp-route-tableName="@tableName" class="btn btn-outline-secondary">נקה</a>
    }
    <div class="me-auto d-flex align-items-center gap-2">
      <label class="form-label mb-0">שורות בעמוד:</label>
      <select name="pageSize" class="form-select form-select-sm" style="max-width:80px" onchange="this.form.submit()">
        @foreach (var s in new[] { 10, 25, 50, 100 })
        {
          if (s == pageSize)
          {
            <option value="@s" selected="selected">@s</option>
          }
          else
          {
            <option value="@s">@s</option>
          }
        }
      </select>
    </div>
  </form>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover table-bordered mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:80px">מזהה</th>
            <th>תיאור</th>
            @if (isLocalities)
            {
              <th style="width:120px">קוד ארצי</th>
            }
            <th style="width:80px">פעיל</th>
            @if (isAdmin)
            {
              <th style="width:110px">פעולות</th>
            }
          </tr>
        </thead>
        <tbody>
          @{
            int baseCols = isAdmin ? 4 : 3;
            int colCount = baseCols + (isLocalities ? 1 : 0);
          }
          @if (!Model.Any())
          {
            <tr>
              <td colspan="@colCount" class="text-center text-muted py-4">אין רשומות להצגה</td>
            </tr>
          }
          @foreach (var item in Model)
          {
            var loc = item as Locality;
            <tr>
              <td>@item.Id</td>
              <td>@item.Description</td>
              @if (isLocalities)
              {
                <td>@(loc?.NationalCode?.ToString() ?? "—")</td>
              }
              <td>
                @if (item.IsActive)
                {
                  <span class="badge bg-success">כן</span>
                }
                else
                {
                  <span class="badge bg-secondary">לא</span>
                }
              </td>
              @if (isAdmin)
              {
                <td>
                  <button type="button" class="btn btn-sm btn-outline-secondary btn-edit"
                          data-id="@item.Id"
                          data-description="@item.Description"
                          data-active="@item.IsActive.ToString().ToLower()"
                          data-nationalcode="@(loc?.NationalCode?.ToString() ?? "")"
                          title="עריכה">
                    ✏️
                  </button>
                  <form asp-action="Delete" asp-route-tableName="@tableName" asp-route-id="@item.Id"
                        method="post" style="display:inline" class="delete-form"
                        data-description="@item.Description">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="מחיקה">🗑️</button>
                  </form>
                </td>
              }
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  @if (totalPages > 1)
  {
    <nav class="mt-3" aria-label="דפדוף">
      <ul class="pagination">
        @if (page > 1)
        {
          <li class="page-item">
            <a class="page-link" asp-action="List" asp-route-tableName="@tableName"
               asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize"
               asp-route-search="@ViewBag.Search">הקודם</a>
          </li>
        }
        @for (int i = Math.Max(1, page - 3); i <= Math.Min(totalPages, page + 3); i++)
        {
          <li class="page-item @(i == page ? "active" : "")">
            <a class="page-link" asp-action="List" asp-route-tableName="@tableName"
               asp-route-page="@i" asp-route-pageSize="@pageSize"
               asp-route-search="@ViewBag.Search">@i</a>
          </li>
        }
        @if (page < totalPages)
        {
          <li class="page-item">
            <a class="page-link" asp-action="List" asp-route-tableName="@tableName"
               asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize"
               asp-route-search="@ViewBag.Search">הבא</a>
          </li>
        }
      </ul>
    </nav>
    <p class="text-muted small">@($"סה\"כ {total} רשומות, עמוד {page} מתוך {totalPages}")</p>
  }
</div>

  @if (isAdmin)
  {
    <div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalTitle" aria-modal="true" role="dialog">
      <div class="modal-dialog" role="dialog" aria-modal="true">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addModalTitle">ייבוא אקסל</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור חלון"></button>
          </div>
          <form asp-action="ImportExcel" asp-route-tableName="@tableName" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="modal-body">
              <p class="text-muted">הקובץ צריך להיות בפורמט xlsx. שורה ראשונה כותרת, עמודה ראשונה תיאור.</p>
              <input type="file" name="file" accept=".xlsx" class="form-control" required />
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
              <button type="submit" class="btn btn-success">ייבוא</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Add Modal -->
  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">הוסף רשומה — @ViewBag.DisplayName</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור"></button>
        </div>
        <form asp-action="Create" asp-route-tableName="@tableName" method="post">
          @Html.AntiForgeryToken()
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label" for="addDescription">תיאור <span class="text-danger">*</span></label>
              <input id="addDescription" name="description" class="form-control" required maxlength="200" aria-required="true" />
            </div>
            @if (isLocalities)
            {
              <div class="mb-3">
                <label class="form-label" for="addNationalCode">קוד ארצי</label>
                <input id="addNationalCode" name="nationalCode" type="number" class="form-control" min="0" />
              </div>
            }
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
            <button type="submit" class="btn btn-primary">שמור</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editModalLabel">עדכון רשומה</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="סגור"></button>
        </div>
        <form id="editForm" method="post">
          @Html.AntiForgeryToken()
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label" for="editDescription">תיאור <span class="text-danger">*</span></label>
              <input id="editDescription" name="description" class="form-control" required maxlength="200" aria-required="true" />
            </div>
            @if (isLocalities)
            {
              <div class="mb-3">
                <label class="form-label" for="editNationalCode">קוד ארצי</label>
                <input id="editNationalCode" name="nationalCode" type="number" class="form-control" min="0" />
              </div>
            }
            <div class="mb-3 form-check">
              <input id="editIsActive" name="isActive" type="checkbox" class="form-check-input" value="true" />
              <label class="form-check-label" for="editIsActive">פעיל</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ביטול</button>
            <button type="submit" class="btn btn-primary">שמור</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var tableNameVal = @Json.Serialize(tableName);

      document.querySelectorAll('.btn-edit').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-id');
          var desc = btn.getAttribute('data-description');
          var active = btn.getAttribute('data-active') === 'true';
          document.getElementById('editDescription').value = desc;
          document.getElementById('editIsActive').checked = active;
          var ncInput = document.getElementById('editNationalCode');
          if (ncInput) {
            ncInput.value = btn.getAttribute('data-nationalcode') || '';
          }
          document.getElementById('editForm').action = '/Lookup/' + tableNameVal + '/Edit/' + id;
          new bootstrap.Modal(document.getElementById('editModal')).show();
        });
      });

      document.querySelectorAll('.delete-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          var desc = form.getAttribute('data-description');
          if (!confirm('האם למחוק את הרשומה "' + desc + '"?')) {
            e.preventDefault();
          }
        });
      });
    })();
  </script>
}
