@model AxiomaReporting.Core.DTOs.AllocationDto
@{
  var employee = (AxiomaReporting.Core.Entities.User)ViewBag.Employee;
  bool isEdit = ViewBag.IsEdit == true;
  ViewData["Title"] = isEdit ? "עריכת הקצאה" : "הוספת הקצאה";
  decimal[] durationOptions = (decimal[])ViewBag.OutputDurationOptions;

  var districts = (List<AxiomaReporting.Core.Entities.District>)ViewBag.Districts;
  var programs = (List<AxiomaReporting.Core.Entities.Program>)ViewBag.Programs;
  var sectors = (List<AxiomaReporting.Core.Entities.Sector>)ViewBag.Sectors;
  var localities = (List<AxiomaReporting.Core.Entities.Locality>)ViewBag.Localities;
  var frameworks = (List<AxiomaReporting.Core.Entities.Framework>)ViewBag.Frameworks;
  var subjects = (List<AxiomaReporting.Core.Entities.Subject>)ViewBag.Subjects;
  var domains = (List<AxiomaReporting.Core.Entities.Domain>)ViewBag.Domains;
  var educationalPrograms = (List<AxiomaReporting.Core.Entities.EducationalProgram>)ViewBag.EducationalPrograms;
  var classes = (List<AxiomaReporting.Core.Entities.SchoolClass>)ViewBag.Classes;
  var gradeLevels = (List<AxiomaReporting.Core.Entities.GradeLevel>)ViewBag.GradeLevels;
  var discussionCodes = (List<AxiomaReporting.Core.Entities.DiscussionCode>)ViewBag.DiscussionCodes;
  var localityDistrictNationals = (List<AxiomaReporting.Core.Entities.LocalityDistrictNational>)ViewBag.LocalityDistrictNationals;
}

<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3>@ViewData["Title"]</h3>
      <h5 class="text-muted">@employee.FirstName @employee.LastName — קוד: @employee.EmployeeCode</h5>
    </div>
    <a asp-action="Allocations" asp-route-id="@employee.Id"
       class="btn btn-outline-secondary">חזרה להקצאות</a>
  </div>

  <form method="post"
        asp-action="@(isEdit ? "EditAllocation" : "CreateAllocation")"
        asp-route-id="@employee.Id"
        asp-route-allocationId="@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <!-- Basic allocation info -->
    <div class="card mb-3 border-success">
      <div class="card-header bg-success text-white fw-bold">פרטי הקצאה</div>
      <div class="card-body">
        <div class="row g-3">

          <div class="col-md-6">
            <label asp-for="ProjectId" class="form-label">פרויקט <span class="text-danger">*</span></label>
            <select asp-for="ProjectId" asp-items="ViewBag.Projects" id="projectIdSelect" class="form-select">
              <option value="">-- בחר פרויקט --</option>
            </select>
            <span asp-validation-for="ProjectId" class="text-danger small"></span>
          </div>

          <div class="col-md-6">
            <label class="form-label" for="programIdsSelect">תוכניות</label>
            <select name="ProgramIds" id="programIdsSelect" multiple class="form-select" size="5"
                    data-initial-selected="@string.Join(",", Model.ProgramIds)"
                    aria-describedby="programsHelp">
              @foreach (var item in programs)
              {
                <option value="@item.Id"
                        selected="@(Model.ProgramIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
            <small id="programsHelp" class="form-text text-muted">
              התוכניות יסוננו לפי הפרויקט הנבחר. אם לא הוגדרה מפה, יוצגו כל התוכניות.
            </small>
          </div>

          <div class="col-md-3">
            @{
              var reportTypes = ViewBag.ReportTypes as List<AxiomaReporting.Core.Entities.ReportType>
                ?? new List<AxiomaReporting.Core.Entities.ReportType>();
            }
            <label asp-for="ReportTypeId" class="form-label">סוג דיווח</label>
            <select asp-for="ReportTypeId" class="form-select" data-no-choices="1">
              <option value="">ללא</option>
              @foreach (var rt in reportTypes)
              {
                <option value="@rt.Id" selected="@(Model.ReportTypeId == rt.Id)">@rt.Description</option>
              }
            </select>
          </div>

          <div class="col-md-3">
            <label asp-for="AnnualEmploymentScope" class="form-label">היקף פעילות שנתי</label>
            <input asp-for="AnnualEmploymentScope" type="number" step="1" min="0" inputmode="numeric" pattern="\d*"
                   class="form-control whole-number-field"
                   data-val-wholenumber="יש להזין מספר שלם" />
            <span asp-validation-for="AnnualEmploymentScope" class="text-danger small"></span>
          </div>

          <div class="col-md-3">
            <label asp-for="MonthlyEmploymentScope" class="form-label">היקף פעילות חודשי</label>
            <input asp-for="MonthlyEmploymentScope" type="number" step="1" min="0" inputmode="numeric" pattern="\d*"
                   class="form-control whole-number-field"
                   data-val-wholenumber="יש להזין מספר שלם" />
            <span asp-validation-for="MonthlyEmploymentScope" class="text-danger small"></span>
          </div>

          <div class="col-md-4">
            <label class="form-label">היקף פעילות יומי</label>
            <div class="input-group">
              <input asp-for="DailyEmploymentScope" type="number" step="1" min="0" inputmode="numeric" pattern="\d*"
                     class="form-control whole-number-field" id="dailyScope"
                     data-val-wholenumber="יש להזין מספר שלם" />
              <div class="input-group-text">
                <input type="checkbox" id="unlimitedDaily" class="form-check-input mt-0"
                       @(Model.DailyEmploymentScope == null ? "checked" : "") />
                <label for="unlimitedDaily" class="form-check-label ms-1">ללא הגבלה</label>
              </div>
            </div>
            <span asp-validation-for="DailyEmploymentScope" class="text-danger small"></span>
          </div>

          <div class="col-md-4">
            <label asp-for="MonthlyRowAllocation" class="form-label">הקצאת שורות חודשית</label>
            <input asp-for="MonthlyRowAllocation" type="number" step="1" min="0" inputmode="numeric" pattern="\d*"
                   class="form-control whole-number-field" />
            <span asp-validation-for="MonthlyRowAllocation" class="text-danger small"></span>
          </div>

          <div class="col-md-4">
            <label asp-for="AnnualRowAllocation" class="form-label">הקצאת שורות שנתית</label>
            <input asp-for="AnnualRowAllocation" type="number" step="1" min="0" inputmode="numeric" pattern="\d*"
                   class="form-control whole-number-field" />
            <span asp-validation-for="AnnualRowAllocation" class="text-danger small"></span>
          </div>

          <div class="col-12">
            <label class="form-label">משך תפוקה (ניתן לבחור מספר ערכים)</label>
            <div class="d-flex flex-wrap gap-3">
              @foreach (var dur in durationOptions)
              {
                <div class="form-check">
                  <input type="checkbox" name="OutputDurationValues" value="@dur"
                         class="form-check-input"
                         id="dur_@dur.ToString().Replace(".", "_")"
                         @(Model.OutputDurationValues.Contains(dur) ? "checked" : "") />
                  <label class="form-check-label"
                         for="dur_@dur.ToString().Replace(".", "_")">@dur</label>
                </div>
              }
              <div class="form-check">
                <input asp-for="OutputDurationUnlimited" class="form-check-input" type="checkbox" id="durUnlimited" />
                <label class="form-check-label" for="durUnlimited">ללא הגבלה</label>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="form-check">
              <input asp-for="AllowExcelUpload" class="form-check-input" type="checkbox" />
              <label asp-for="AllowExcelUpload" class="form-check-label">אפשר העלאת אקסל</label>
            </div>
          </div>

          <div class="col-12">
            <label asp-for="Notes" class="form-label">הערות</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
          </div>

        </div>
      </div>
    </div>

    <!-- Multi-select fields -->
    <div class="card mb-3">
      <div class="card-header fw-bold">שיוכים</div>
      <div class="card-body">
        <div class="row g-3">

          <div class="col-md-6">
            <label class="form-label">מחוזות</label>
            <select name="DistrictIds" multiple class="form-select" size="5">
              @foreach (var item in districts)
              {
                <option value="@item.Id"
                        selected="@(Model.DistrictIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">מגזרים</label>
            <select name="SectorIds" multiple class="form-select" size="5">
              @foreach (var item in sectors)
              {
                <option value="@item.Id"
                        selected="@(Model.SectorIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">ישובים</label>
            <select name="LocalityIds" multiple class="form-select" size="5">
              @foreach (var item in localities)
              {
                <option value="@item.Id"
                        selected="@(Model.LocalityIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">מסגרות</label>
            @{
              var fwLabels = ViewBag.FrameworkLabels as Dictionary<int, string> ?? new Dictionary<int, string>();
            }
            <select name="FrameworkIds" multiple class="form-select" size="5">
              @foreach (var item in frameworks)
              {
                <option value="@item.Id"
                        selected="@(Model.FrameworkIds.Contains(item.Id))">@(fwLabels.TryGetValue(item.Id, out var fl) ? fl : item.Description)</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">נושאים</label>
            <select name="SubjectIds" multiple class="form-select" size="5">
              @foreach (var item in subjects)
              {
                <option value="@item.Id"
                        selected="@(Model.SubjectIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">תחומים</label>
            <select name="DomainIds" multiple class="form-select" size="5">
              @foreach (var item in domains)
              {
                <option value="@item.Id"
                        selected="@(Model.DomainIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">תוכניות חינוכיות</label>
            <select name="EducationalProgramIds" multiple class="form-select" size="5">
              @foreach (var item in educationalPrograms)
              {
                <option value="@item.Id"
                        selected="@(Model.EducationalProgramIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">שכבות</label>
            <select name="GradeLevelIds" multiple class="form-select" size="5">
              @foreach (var item in gradeLevels)
              {
                <option value="@item.Id"
                        selected="@(Model.GradeLevelIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">קודי דיון</label>
            <select name="DiscussionCodeIds" multiple class="form-select" size="5">
              @foreach (var item in discussionCodes)
              {
                <option value="@item.Id"
                        selected="@(Model.DiscussionCodeIds.Contains(item.Id))">@item.Description</option>
              }
            </select>
          </div>

        </div>
        <p class="text-muted small mt-2">לבחירה מרובה יש להחזיק את מקש הבחירה המרובה במקלדת וללחוץ על הפריטים.</p>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">שמור הקצאה</button>
      @if (!isEdit)
      {
        <button type="submit" name="continueAdding" value="true" class="btn btn-success">שמור והוסף עוד</button>
      }
      <a asp-action="Allocations" asp-route-id="@employee.Id"
         class="btn btn-outline-secondary">ביטול</a>
    </div>
  </form>
</div>

@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")
  <script>
    // Toggle daily scope input when "unlimited" checkbox is clicked
    const unlimitedDaily = document.getElementById('unlimitedDaily');
    const dailyScope = document.getElementById('dailyScope');

    function toggleDailyScope() {
      if (unlimitedDaily.checked) {
        dailyScope.value = '';
        dailyScope.disabled = true;
      } else {
        dailyScope.disabled = false;
      }
    }

    unlimitedDaily.addEventListener('change', toggleDailyScope);
    toggleDailyScope(); // initialize on page load

    document.querySelectorAll('.whole-number-field').forEach((input) => {
      input.addEventListener('input', () => {
        input.value = input.value.replace(/[^\d]/g, '');
      });
      input.addEventListener('wheel', () => input.blur());
    });

    // --- Cascading Project -> Programs (list is filtered to the selected project) ---
    const projectSelect = document.getElementById('projectIdSelect');
    const programsSelect = document.getElementById('programIdsSelect');
    const programsUrl = '@Url.Action("ProgramsForProject", "Employee")';

    // Own the Choices.js instance here so the global initializer in _Layout skips it
    // (it bails when data-choices-init is already set). Rebuilding the native <select>'s
    // options directly would NOT update the Choices widget, so we must go through its API.
    let programsChoices = null;
    if (programsSelect && typeof window.Choices !== 'undefined') {
      programsSelect.dataset.choicesInit = '1';
      try {
        programsChoices = new window.Choices(programsSelect, {
          removeItemButton: true,
          searchPlaceholderValue: 'חיפוש…',
          noResultsText: 'לא נמצאו תוצאות',
          shouldSort: false,
          itemSelectText: ''
        });
        window._axChoices = window._axChoices || new WeakMap();
        window._axChoices.set(programsSelect, programsChoices);
      } catch (e) { /* fall back to native <select> */ }
    }

    function currentProgramSelection() {
      if (programsChoices) return programsChoices.getValue(true).map(String);
      return Array.from(programsSelect.selectedOptions).map(o => o.value);
    }

    async function reloadPrograms(projectId, preserve) {
      if (!programsSelect) return;
      const keep = new Set((preserve !== undefined ? preserve : currentProgramSelection()).map(String));

      if (!projectId) {
        // No project chosen → no related programs to show.
        if (programsChoices) programsChoices.clearStore();
        else programsSelect.innerHTML = '';
        return;
      }

      try {
        const resp = await fetch(programsUrl + '?projectId=' + encodeURIComponent(projectId), {
          headers: { 'Accept': 'application/json' }
        });
        if (!resp.ok) throw new Error('network');
        const data = await resp.json();
        const choices = data.map(item => ({
          value: String(item.id),
          label: item.description,
          selected: keep.has(String(item.id))
        }));

        if (programsChoices) {
          programsChoices.setChoices(choices, 'value', 'label', true);
        } else {
          programsSelect.innerHTML = '';
          for (const c of choices) {
            const opt = document.createElement('option');
            opt.value = c.value;
            opt.textContent = c.label;
            opt.selected = c.selected;
            programsSelect.appendChild(opt);
          }
        }
      } catch (err) {
        // Graceful failure: leave current options in place so the user isn't stuck.
        console.warn('ProgramsForProject fetch failed:', err);
      }
    }

    if (projectSelect) {
      // Changing the project resets the program selection to that project's list.
      projectSelect.addEventListener('change', (e) => reloadPrograms(e.target.value, []));

      // On first load, filter to the already-selected project (preserving any saved
      // selections when editing an existing allocation).
      const initialSelected = (programsSelect?.dataset.initialSelected || '')
        .split(',').map(s => s.trim()).filter(Boolean);
      reloadPrograms(projectSelect.value, initialSelected);
    }

    // --- שיוך אוטומטי של ערכי טבלאות קוד לפי התוכנית שנבחרה (משוב בטא B21) ---
    // בחירת תוכנית מוסיפה את הערכים המשויכים לה (נושאים, תחומים, תוכניות חינוכיות,
    // קיום דיון) לבחירות בכרטיס השיוכים; ניתן לערוך/להסיר לאחר מכן (B6).
    // מסגרות מוחרגות בכוונה — נקבעות רק לפי הקצאת העובד (QA #4).
    const valuesUrl = '@Url.Action("ValuesForProgram", "Employee")';
    const scopeTargets = {
      subjectIds: 'select[name="SubjectIds"]',
      domainIds: 'select[name="DomainIds"]',
      educationalProgramIds: 'select[name="EducationalProgramIds"]',
      discussionCodeIds: 'select[name="DiscussionCodeIds"]'
    };

    function addSelections(selector, ids) {
      const el = document.querySelector(selector);
      if (!el || !ids || !ids.length) return;
      const inst = window._axChoices && window._axChoices.get ? window._axChoices.get(el) : null;
      ids.forEach(id => {
        if (inst) inst.setChoiceByValue(String(id));
        else {
          const opt = Array.from(el.options).find(o => o.value === String(id));
          if (opt) opt.selected = true;
        }
      });
    }

    async function applyProgramValues(programId) {
      const projectId = projectSelect ? projectSelect.value : '';
      if (!projectId || !programId) return;
      try {
        const resp = await fetch(`${valuesUrl}?projectId=${encodeURIComponent(projectId)}&programId=${encodeURIComponent(programId)}`,
          { headers: { 'Accept': 'application/json' } });
        if (!resp.ok) return;
        const data = await resp.json();
        Object.entries(scopeTargets).forEach(([key, sel]) => addSelections(sel, data[key]));
      } catch (err) {
        console.warn('ValuesForProgram fetch failed:', err);
      }
    }

    if (programsSelect) {
      let prevPrograms = new Set(currentProgramSelection());
      programsSelect.addEventListener('change', () => {
        const now = currentProgramSelection();
        now.filter(id => !prevPrograms.has(id)).forEach(applyProgramValues);
        prevPrograms = new Set(now);
      });
    }
  </script>
}
