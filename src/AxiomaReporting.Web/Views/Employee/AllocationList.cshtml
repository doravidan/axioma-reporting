@using AxiomaReporting.Web.Models
@model List<AxiomaReporting.Core.Entities.Allocation>
@{
  ViewData["Title"] = "הקצאות עובדים";
  var filter = (AllocationListFilterModel)ViewBag.Filter;
  var page = (int)ViewBag.Page;
  var totalPages = (int)ViewBag.TotalPages;
  var pageSize = (int)ViewBag.PageSize;
  var projects = ViewBag.Projects as List<AxiomaReporting.Core.Entities.Project> ?? new();
  var allPrograms = ViewBag.AllPrograms as List<AxiomaReporting.Core.Entities.Program> ?? new();
  var allDistricts = ViewBag.AllDistricts as List<AxiomaReporting.Core.Entities.District> ?? new();
  var allSectors = ViewBag.AllSectors as List<AxiomaReporting.Core.Entities.Sector> ?? new();
  var durationOptions = (decimal[])ViewBag.OutputDurationOptions;
  string? sortBy = ViewBag.SortBy as string;
  bool sortDesc = ViewBag.SortDesc ?? false;
  var listController = ViewBag.AllocationListController as string ?? "Allocations";
  var listAction = ViewBag.AllocationListAction as string ?? "Index";
  var exportAction = ViewBag.AllocationExportAction as string ?? "ExportExcel";
  var detailController = ViewBag.AllocationDetailController as string ?? "Allocations";
  var detailAction = ViewBag.AllocationDetailAction as string ?? "Details";
  var employeeContext = ViewBag.EmployeeContext as AxiomaReporting.Core.Entities.User;

  var baseRouteValues = new Dictionary<string, object?>
  {
    ["search"] = filter.Search,
    ["employeeId"] = filter.EmployeeId,
    ["projectId"] = filter.ProjectId,
    ["idNumber"] = filter.IdNumber,
    ["employeeCode"] = filter.EmployeeCode,
    ["firstName"] = filter.FirstName,
    ["lastName"] = filter.LastName,
    ["monthlyEmploymentScope"] = filter.MonthlyEmploymentScope,
    ["annualEmploymentScope"] = filter.AnnualEmploymentScope,
    ["notes"] = filter.Notes,
    ["showAll"] = filter.ShowAll,
    ["pageSize"] = pageSize
  };

  var extraRouteValues = new List<KeyValuePair<string, string>>();
  foreach (var id in filter.ProgramIds) extraRouteValues.Add(new("programIds", id.ToString()));
  foreach (var id in filter.DistrictIds) extraRouteValues.Add(new("districtIds", id.ToString()));
  foreach (var id in filter.SectorIds) extraRouteValues.Add(new("sectorIds", id.ToString()));
  foreach (var val in filter.OutputDurations) extraRouteValues.Add(new("outputDurations", val));

  string BuildUrl(string action, IDictionary<string, object?> overrides)
  {
    var qs = new List<string>();
    var merged = new Dictionary<string, object?>(baseRouteValues);
    foreach (var kv in overrides) merged[kv.Key] = kv.Value;
    foreach (var kv in merged)
    {
      if (kv.Value == null) continue;
      var s = kv.Value.ToString();
      if (string.IsNullOrEmpty(s)) continue;
      if (kv.Value is bool b && !b && kv.Key != "sortDesc" && kv.Key != "showAll") continue;
      qs.Add(Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(s!));
    }
    foreach (var kv in extraRouteValues)
      qs.Add(Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value));
    return Url.Action(action, listController)! + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
  }

  string SortLink(string key) => BuildUrl(listAction, new Dictionary<string, object?>
  {
    ["sortBy"] = key,
    ["sortDesc"] = sortBy == key ? !sortDesc : false,
    ["page"] = 1
  });

  string PageLink(int p) => BuildUrl(listAction, new Dictionary<string, object?>
  {
    ["sortBy"] = sortBy,
    ["sortDesc"] = sortDesc,
    ["page"] = p
  });

  string ExportLink() => BuildUrl(exportAction, new Dictionary<string, object?>
  {
    ["sortBy"] = sortBy,
    ["sortDesc"] = sortDesc
  });

  string JoinValues(IEnumerable<string?> values)
  {
    var distinct = values.Where(v => !string.IsNullOrWhiteSpace(v)).Distinct().ToList();
    return distinct.Count == 0 ? "" : string.Join(", ", distinct);
  }

  string FilteredJoin<T>(IEnumerable<T> items, Func<T, int> idSelector, Func<T, string?> descSelector, List<int> selectedIds)
  {
    if (!filter.ShowAll && selectedIds is { Count: > 0 })
      items = items.Where(x => selectedIds.Contains(idSelector(x)));
    return JoinValues(items.Select(descSelector));
  }

  string FilteredDuration(string? raw)
  {
    if (string.IsNullOrWhiteSpace(raw)) return "";
    var tokens = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    if (!filter.ShowAll && filter.OutputDurations is { Count: > 0 })
      tokens = tokens.Where(t => filter.OutputDurations.Contains(t)).ToList();
    tokens = tokens.Select(t => t.Equals("Unlimited", StringComparison.OrdinalIgnoreCase) ? "ללא הגבלה" : t).ToList();
    return tokens.Count == 0 ? "" : string.Join(", ", tokens);
  }

  string DisplayIdNumber(string? value) =>
    string.IsNullOrWhiteSpace(value)
      ? ""
      : (System.Text.RegularExpressions.Regex.IsMatch(value, "[A-Za-z]") ? "מנהל מערכת" : value);
  string Whole(decimal? value) => value.HasValue ? decimal.Truncate(value.Value).ToString("0") : "";
  string Daily(decimal? value) => value.HasValue ? value.Value.ToString("0.##") : "ללא הגבלה";
  string Int(int? value) => value.HasValue ? value.Value.ToString() : "";
  string YesNo(bool value) => value ? "כן" : "לא";
}

<div class="container-fluid employee-allocations-list py-3" dir="rtl">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h2 class="mb-0">הקצאות עובדים</h2>
      @if (employeeContext != null)
      {
        <div class="text-muted fw-bold">@employeeContext.FirstName @employeeContext.LastName קוד עובד @employeeContext.EmployeeCode ת.ז @DisplayIdNumber(employeeContext.IdNumber)</div>
      }
    </div>
    <div class="d-flex gap-2 flex-wrap">
      @if (employeeContext != null)
      {
        <a asp-controller="Employee" asp-action="CreateAllocation" asp-route-id="@employeeContext.Id" class="btn btn-primary">הוסף הקצאה</a>
        <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employeeContext.Id" class="btn btn-outline-secondary">חזרה לכרטיס עובד</a>
      }
      else if (User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3"))
      {
        @* הוסף הקצאה ללא הקשר עובד: מסך איתור עובד ייעודי (משוב בטא B8, QA #1; יישור לגרסת השרת) *@
        <a href="/allocations/create" class="btn btn-primary">הוסף הקצאה</a>
      }
      <a href="@ExportLink()" class="btn btn-success">יצא לאקסל</a>
    </div>
  </div>

  <form method="get" class="card card-body mb-3 allocation-filter">
    <div class="filter-title h5 mb-3">סנן לפי</div>
    <div class="filter-grid">
      <div class="filter-field notes-field">
        <label for="f-notes">הערות הקצאה</label>
        <input id="f-notes" type="text" name="notes" value="@filter.Notes" />
      </div>

      <div class="filter-field duration-field">
        <label for="f-durations">משך תפוקה</label>
        <select id="f-durations" name="outputDurations" multiple size="3">
          @foreach (var d in durationOptions)
          {
            var dv = d.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <option value="@dv" selected="@(filter.OutputDurations.Contains(dv))">@d</option>
          }
          <option value="Unlimited" selected="@(filter.OutputDurations.Contains("Unlimited"))">ללא הגבלה</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="f-annual">היקף פעילות שנתי</label>
        <input id="f-annual" type="number" step="1" name="annualEmploymentScope"
               value="@(filter.AnnualEmploymentScope.HasValue ? decimal.Truncate(filter.AnnualEmploymentScope.Value).ToString("0") : null)" />
      </div>

      <div class="filter-field">
        <label for="f-monthly">היקף פעילות חודשי</label>
        <input id="f-monthly" type="number" step="1" name="monthlyEmploymentScope"
               value="@(filter.MonthlyEmploymentScope.HasValue ? decimal.Truncate(filter.MonthlyEmploymentScope.Value).ToString("0") : null)" />
      </div>

      <div class="filter-field">
        <label for="f-last">שם משפחה</label>
        <input id="f-last" type="text" name="lastName" value="@filter.LastName" />
      </div>

      <div class="filter-field">
        <label for="f-first">שם פרטי</label>
        <input id="f-first" type="text" name="firstName" value="@filter.FirstName" />
      </div>

      <div class="filter-field">
        <label for="f-code">קוד עובד</label>
        <input id="f-code" type="text" name="employeeCode" value="@filter.EmployeeCode" />
      </div>

      <div class="filter-field">
        <label for="f-id">ת.ז</label>
        <input id="f-id" type="text" name="idNumber" value="@filter.IdNumber" />
      </div>

      <div class="filter-field">
        <label for="f-sectors">מגזר</label>
        <select id="f-sectors" name="sectorIds" multiple size="3">
          @foreach (var s in allSectors)
          {
            <option value="@s.Id" selected="@(filter.SectorIds.Contains(s.Id))">@s.Description</option>
          }
        </select>
      </div>

      <div class="filter-field">
        <label for="f-districts">מחוז</label>
        <select id="f-districts" name="districtIds" multiple size="3">
          @foreach (var d in allDistricts)
          {
            <option value="@d.Id" selected="@(filter.DistrictIds.Contains(d.Id))">@d.Description</option>
          }
        </select>
      </div>

      <div class="filter-field">
        <label for="f-programs">תוכנית</label>
        <select id="f-programs" name="programIds" multiple size="3">
          @foreach (var p in allPrograms)
          {
            <option value="@p.Id" selected="@(filter.ProgramIds.Contains(p.Id))">@p.Description</option>
          }
        </select>
      </div>

      <div class="filter-field">
        <label for="f-project">פרויקט</label>
        <select id="f-project" name="projectId">
          <option value="">הכל</option>
          @foreach (var p in projects)
          {
            <option value="@p.Id" selected="@(filter.ProjectId == p.Id)">@p.Description</option>
          }
        </select>
      </div>
    </div>

    <div class="filter-actions">
      <label class="show-all">
        <input type="checkbox" name="showAll" value="true" @(filter.ShowAll ? "checked" : "") />
        הצג הכל
      </label>
      <button type="submit" class="btn btn-primary">הצג</button>
      <a href="@ExportLink()" class="btn btn-success">יצא לאקסל</a>
      <a href="@Url.Action(listAction, listController)" class="btn btn-outline-secondary">נקה</a>
    </div>
  </form>

  <div class="allocation-state allocation-loading" hidden role="status">טוען הקצאות...</div>
  <div class="allocation-state allocation-error" hidden role="alert">אירעה שגיאה בטעינת ההקצאות</div>

  <div class="table-responsive alloc-grid-wrap">
    <table class="table table-striped table-hover table-bordered align-middle alloc-grid">
      <thead class="table-dark">
        <tr>
          <th class="icon-col"></th>
          <th><a href="@SortLink("project")">פרויקט</a></th>
          <th><a href="@SortLink("programs")">תוכנית</a></th>
          <th><a href="@SortLink("districts")">מחוז</a></th>
          <th><a href="@SortLink("sectors")">מגזר</a></th>
          <th><a href="@SortLink("idnumber")">ת.ז</a></th>
          <th><a href="@SortLink("code")">קוד עובד</a></th>
          <th><a href="@SortLink("firstname")">שם פרטי</a></th>
          <th><a href="@SortLink("lastname")">שם משפחה</a></th>
          <th><a href="@SortLink("monthlyscope")">היקף פעילות חודשי</a></th>
          <th><a href="@SortLink("dailyscope")">היקף פעילות יומי</a></th>
          <th><a href="@SortLink("annualscope")">היקף פעילות שנתי</a></th>
          <th><a href="@SortLink("monthlyrows")">הקצאת שורות חודשית</a></th>
          <th><a href="@SortLink("annualrows")">הקצאת שורות שנתית</a></th>
          <th><a href="@SortLink("outputduration")">משך תפוקה</a></th>
          <th><a href="@SortLink("allowexcelupload")">העלאת אקסל</a></th>
          <th><a href="@SortLink("notes")">הערות הקצאה</a></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var a in Model)
        {
          <tr>
            <td class="icon-col">
              @if (a.UserId > 0)
              {
                <a asp-controller="@detailController" asp-action="@detailAction" asp-route-allocationId="@a.Id"
                   class="btn btn-sm btn-primary detail-icon" title="פרטי הקצאה" aria-label="פרטי הקצאה">פרטים</a>
              }
            </td>
            <td><span>@a.Project?.Description</span></td>
            <td><span>@FilteredJoin(a.AllocationPrograms, x => x.ProgramId, x => x.Program?.Description, filter.ProgramIds)</span></td>
            <td><span>@FilteredJoin(a.AllocationDistricts, x => x.DistrictId, x => x.District?.Description, filter.DistrictIds)</span></td>
            <td><span>@FilteredJoin(a.AllocationSectors, x => x.SectorId, x => x.Sector?.Description, filter.SectorIds)</span></td>
            <td><span>@DisplayIdNumber(a.User?.IdNumber)</span></td>
            <td><span>@a.User?.EmployeeCode</span></td>
            <td><span>@a.User?.FirstName</span></td>
            <td><span>@a.User?.LastName</span></td>
            <td><span>@Whole(a.MonthlyEmploymentScope)</span></td>
            <td><span>@Daily(a.DailyEmploymentScope)</span></td>
            <td><span>@Whole(a.AnnualEmploymentScope)</span></td>
            <td><span>@Int(a.MonthlyRowAllocation)</span></td>
            <td><span>@Int(a.AnnualRowAllocation)</span></td>
            <td><span>@FilteredDuration(a.OutputDuration)</span></td>
            <td><span>@YesNo(a.AllowExcelUpload)</span></td>
            <td><span>@(string.IsNullOrWhiteSpace(a.Notes) ? "" : a.Notes)</span></td>
          </tr>
        }
        @if (!Model.Any())
        {
          <tr>
            <td colspan="17" class="empty-row text-center text-muted py-4">לא נמצאו הקצאות עובדים</td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  @if (totalPages > 1)
  {
    <nav aria-label="עמוד" class="mt-3">
      <ul class="pagination justify-content-center">
        <li class="page-item @(page <= 1 ? "disabled" : "")">
          <a class="page-link" href="@PageLink(page - 1)">הקודם</a>
        </li>
        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
        {
          <li class="page-item @(i == page ? "active" : "")">
            <a class="page-link" href="@PageLink(i)">@i</a>
          </li>
        }
        <li class="page-item @(page >= totalPages ? "disabled" : "")">
          <a class="page-link" href="@PageLink(page + 1)">הבא</a>
        </li>
      </ul>
    </nav>
  }
</div>

<style>
  .allocation-filter .filter-title {
    font-weight: 700;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(180px, 1fr));
    gap: 1rem;
    align-items: end;
  }

  .filter-field label {
    display: block;
    margin-bottom: .35rem;
    font-weight: 600;
  }

  .filter-field input,
  .filter-field select {
    width: 100%;
    display: block;
    padding: .375rem .75rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #212529;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid #ced4da;
    border-radius: .375rem;
  }

  .filter-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: .75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .show-all {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-weight: 500;
  }

  .alloc-grid-wrap {
    max-height: 60vh;
    overflow: auto;
  }

  .alloc-grid {
    min-width: 1560px;
  }

  .alloc-grid th a,
  .alloc-grid td span {
    color: inherit;
    text-decoration: none;
  }

  .alloc-grid .icon-col {
    width: 82px;
    white-space: nowrap;
  }

  .detail-icon {
    min-width: 62px;
  }

  .empty-row {
    text-align: center;
    padding: 2rem !important;
    color: #64748b;
  }

  .allocation-state {
    text-align: center;
    font-weight: 800;
    padding: 1rem;
    color: #475569;
  }

  @@media (max-width: 1200px) {
    .filter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @@media (max-width: 767.98px) {
    .filter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelector('.allocation-filter')?.addEventListener('submit', () => {
    const loading = document.querySelector('.allocation-loading');
    if (loading) loading.hidden = false;
  });
</script>
