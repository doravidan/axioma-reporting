@using AxiomaReporting.Web.Models
@using AxiomaReporting.Web.Helpers
@model List<AxiomaReporting.Core.Entities.User>
@{
  ViewData["Title"] = "ניהול עובדים";
  var filter = ViewBag.Filter as EmployeeListFilterModel ?? new EmployeeListFilterModel();
  var page = (int)ViewBag.Page;
  var totalPages = (int)ViewBag.TotalPages;
  var pageSize = (int)ViewBag.PageSize;
  var statuses = (List<AxiomaReporting.Core.Entities.UserStatus>)ViewBag.Statuses;
  var userRoles = (List<AxiomaReporting.Core.Entities.UserRole>)ViewBag.UserRoles;
  var projects = ViewBag.Projects as List<AxiomaReporting.Core.Entities.Project> ?? new();
  var allDistricts = ViewBag.AllDistricts as List<AxiomaReporting.Core.Entities.District> ?? new();
  var allPrograms = ViewBag.AllPrograms as List<AxiomaReporting.Core.Entities.Program> ?? new();
  var allSectors = ViewBag.AllSectors as List<AxiomaReporting.Core.Entities.Sector> ?? new();
  string? sortBy = ViewBag.SortBy as string;
  bool sortDesc = ViewBag.SortDesc ?? false;
  string DisplayIdNumber(string? value) =>
    string.IsNullOrWhiteSpace(value)
      ? ""
      : (System.Text.RegularExpressions.Regex.IsMatch(value, "[A-Za-z]") ? "מנהל מערכת" : value);

  // Build the route values that preserve the active filter across navigation/pagination/sort.
  var baseRouteValues = new Dictionary<string, object?>
  {
    ["search"] = filter.Search,
    ["idNumber"] = filter.IdNumber,
    ["employeeCode"] = filter.EmployeeCode,
    ["firstName"] = filter.FirstName,
    ["lastName"] = filter.LastName,
    ["notes"] = filter.Notes,
    ["statusId"] = filter.StatusId,
    ["roleId"] = filter.RoleId,
    ["restDay"] = filter.RestDay,
    ["allowFutureReporting"] = filter.AllowFutureReporting,
    ["hasAllocations"] = filter.HasAllocations,
    ["lockedOnly"] = filter.LockedOnly ? "true" : null,
    ["projectId"] = filter.ProjectId,
    ["pageSize"] = pageSize
  };
  var extraRouteValues = new List<KeyValuePair<string, string>>();
  foreach (var id in filter.DistrictIds) extraRouteValues.Add(new("districtIds", id.ToString()));
  foreach (var id in filter.ProgramIds) extraRouteValues.Add(new("programIds", id.ToString()));
  foreach (var id in filter.SectorIds) extraRouteValues.Add(new("sectorIds", id.ToString()));

  string BuildUrl(string action, IDictionary<string, object?> overrides)
  {
    var qs = new List<string>();
    var merged = new Dictionary<string, object?>(baseRouteValues);
    foreach (var kv in overrides) merged[kv.Key] = kv.Value;
    foreach (var kv in merged)
    {
      if (kv.Value == null) continue;
      var s = kv.Value.ToString();
      if (string.IsNullOrEmpty(s)) continue;
      qs.Add(Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(s!));
    }
    foreach (var kv in extraRouteValues)
      qs.Add(Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value));
    return Url.Action(action, "Employee")! + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
  }

  string SortLink(string key) => BuildUrl("Index", new Dictionary<string, object?>
  {
    ["sortBy"] = key,
    ["sortDesc"] = sortBy == key ? (!sortDesc ? "true" : null) : null,
    ["page"] = 1
  });

  string PageLink(int p) => BuildUrl("Index", new Dictionary<string, object?>
  {
    ["sortBy"] = sortBy,
    ["sortDesc"] = sortDesc ? "true" : null,
    ["page"] = p
  });

  string ExportLink() => BuildUrl("ExportExcel", new Dictionary<string, object?>
  {
    ["sortBy"] = sortBy,
    ["sortDesc"] = sortDesc ? "true" : null
  });

  string AriaSort(string key) => sortBy == key ? (sortDesc ? "descending" : "ascending") : "none";

  string Values(IEnumerable<string?> values)
  {
    var distinct = values.Where(v => !string.IsNullOrWhiteSpace(v)).Distinct().ToList();
    return distinct.Count == 0 ? "-" : string.Join(", ", distinct);
  }
}

<div class="container-fluid py-3" dir="rtl">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>ניהול עובדים</h2>
    <div class="d-flex gap-2 flex-wrap">
      <a asp-action="Create" class="btn btn-primary">+ הוסף עובד</a>
      <a asp-controller="Allocations" asp-action="Index" class="btn btn-outline-primary">רשימת הקצאות</a>
      <a href="@ExportLink()" class="btn btn-success">ייצוא אקסל</a>
    </div>
  </div>

  @if (TempData["Success"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }
  @if (TempData["Error"] != null)
  {
    <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="polite">
      @TempData["Error"]
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="סגור הודעה"></button>
    </div>
  }

  <form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">

      <div class="col-md-3">
        <label class="form-label" for="f-search">חיפוש כללי</label>
        <input id="f-search" type="text" name="search" value="@filter.Search" class="form-control"
               placeholder="שם, ת.ז., קוד עובד..." />
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-id">ת.ז.</label>
        <input id="f-id" type="text" name="idNumber" value="@filter.IdNumber" class="form-control" />
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-code">קוד עובד</label>
        <input id="f-code" type="text" name="employeeCode" value="@filter.EmployeeCode" class="form-control" />
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-first">שם פרטי</label>
        <input id="f-first" type="text" name="firstName" value="@filter.FirstName" class="form-control" />
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-last">שם משפחה</label>
        <input id="f-last" type="text" name="lastName" value="@filter.LastName" class="form-control" />
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-status">סטטוס</label>
        <select id="f-status" name="statusId" class="form-select">
          <option value="">-- כל הסטטוסים --</option>
          @foreach (var s in statuses)
          {
            <option value="@s.Id" selected="@(filter.StatusId == s.Id)">@(s.DescriptionHebrew ?? s.Name)</option>
          }
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-role">תפקיד מערכת</label>
        <select id="f-role" name="roleId" class="form-select">
          <option value="">-- כל התפקידים --</option>
          @foreach (var r in userRoles)
          {
            <option value="@r.Id" selected="@(filter.RoleId == r.Id)">@(r.DescriptionHebrew ?? r.Name)</option>
          }
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-restday">יום מנוחה</label>
        <select id="f-restday" name="restDay" class="form-select">
          <option value="">-- הכל --</option>
          @foreach (var rd in SelectListProviders.RestDayOptions.Skip(1))
          {
            <option value="@rd.Value" selected="@(filter.RestDay?.ToString() == rd.Value)">@rd.Text</option>
          }
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-future">דיווח עתידי</label>
        <select id="f-future" name="allowFutureReporting" class="form-select">
          <option value="" selected="@(!filter.AllowFutureReporting.HasValue)">-- הכל --</option>
          <option value="true" selected="@(filter.AllowFutureReporting == true)">כן</option>
          <option value="false" selected="@(filter.AllowFutureReporting == false)">לא</option>
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label" for="f-hasalloc">יש הקצאות</label>
        <select id="f-hasalloc" name="hasAllocations" class="form-select">
          <option value="" selected="@(!filter.HasAllocations.HasValue)">-- הכל --</option>
          <option value="true" selected="@(filter.HasAllocations == true)">כן</option>
          <option value="false" selected="@(filter.HasAllocations == false)">לא</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="f-project">פרויקט</label>
        <select id="f-project" name="projectId" class="form-select">
          <option value="">-- כל הפרויקטים --</option>
          @foreach (var p in projects)
          {
            <option value="@p.Id" selected="@(filter.ProjectId == p.Id)">@p.Description</option>
          }
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="f-districts">מחוז</label>
        <select id="f-districts" name="districtIds" multiple class="form-select" size="3"
                aria-label="סינון לפי מחוז (בחירה מרובה)">
          @foreach (var d in allDistricts)
          {
            <option value="@d.Id" selected="@(filter.DistrictIds.Contains(d.Id))">@d.Description</option>
          }
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="f-programs">תוכנית</label>
        <select id="f-programs" name="programIds" multiple class="form-select" size="3"
                aria-label="סינון לפי תוכנית (בחירה מרובה)">
          @foreach (var p in allPrograms)
          {
            <option value="@p.Id" selected="@(filter.ProgramIds.Contains(p.Id))">@p.Description</option>
          }
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="f-sectors">מגזר</label>
        <select id="f-sectors" name="sectorIds" multiple class="form-select" size="3"
                aria-label="סינון לפי מגזר (בחירה מרובה)">
          @foreach (var s in allSectors)
          {
            <option value="@s.Id" selected="@(filter.SectorIds.Contains(s.Id))">@s.Description</option>
          }
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="f-notes">הערות</label>
        <input id="f-notes" type="text" name="notes" value="@filter.Notes" class="form-control" />
      </div>

      <div class="col-md-2 d-flex align-items-center pt-3">
        <div class="form-check">
          <input id="f-locked" class="form-check-input" type="checkbox"
                 name="lockedOnly" value="true" @(filter.LockedOnly ? "checked" : "") />
          <label class="form-check-label" for="f-locked">רק חשבונות נעולים</label>
        </div>
      </div>

      <div class="col-md-1">
        <label class="form-label" for="f-pageSize">שורות</label>
        <select id="f-pageSize" name="pageSize" class="form-select">
          @foreach (var size in new[] { 10, 25, 50, 100 })
          {
            <option value="@size" selected="@(pageSize == size)">@size</option>
          }
        </select>
      </div>

      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-secondary w-100">חפש</button>
        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary w-100">נקה</a>
      </div>
    </div>
  </form>

  <form method="post" asp-action="BulkAction" id="bulkForm">
    @Html.AntiForgeryToken()
    @* Hidden filter inputs so the POST → Redirect can preserve filter state (Fix #14). *@
    <input type="hidden" name="search" value="@filter.Search" />
    <input type="hidden" name="idNumber" value="@filter.IdNumber" />
    <input type="hidden" name="employeeCode" value="@filter.EmployeeCode" />
    <input type="hidden" name="firstName" value="@filter.FirstName" />
    <input type="hidden" name="lastName" value="@filter.LastName" />
    <input type="hidden" name="notes" value="@filter.Notes" />
    @if (filter.StatusId.HasValue) { <input type="hidden" name="statusId" value="@filter.StatusId" /> }
    @if (filter.RoleId.HasValue) { <input type="hidden" name="roleId" value="@filter.RoleId" /> }
    @if (filter.RestDay.HasValue) { <input type="hidden" name="restDay" value="@filter.RestDay" /> }
    @if (filter.AllowFutureReporting.HasValue) { <input type="hidden" name="allowFutureReporting" value="@filter.AllowFutureReporting.Value.ToString().ToLowerInvariant()" /> }
    @if (filter.HasAllocations.HasValue) { <input type="hidden" name="hasAllocations" value="@filter.HasAllocations.Value.ToString().ToLowerInvariant()" /> }
    @if (filter.LockedOnly) { <input type="hidden" name="lockedOnly" value="true" /> }

    <div class="card mb-3 d-none" id="bulkBar">
      <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <span class="fw-bold">פעולה קבוצתית:</span>
        <select name="newStatusId" class="form-select w-auto">
          @foreach (var s in statuses)
          {
            <option value="@s.Id">@(s.DescriptionHebrew ?? s.Name)</option>
          }
        </select>
        <button type="submit" class="btn btn-warning">עדכון סטטוס</button>
        <select name="bulkProjectId" class="form-select w-auto">
          <option value="">בחר פרויקט להקצאה</option>
          @foreach (var p in projects)
          {
            <option value="@p.Id">@p.Description</option>
          }
        </select>
        <button type="submit" formaction="@Url.Action("BulkAddAllocation")" class="btn btn-outline-success">
          הוסף הקצאה
        </button>
        <span id="selectedCount" class="text-muted"></span>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            @* Actions column moved to FIRST position (right side in RTL) per client Fix #13. *@
            <th scope="col" aria-sort="none">
              <span class="visually-hidden">פעולות</span>
            </th>
            <th scope="col"><input type="checkbox" id="selectAll" aria-label="בחר הכל" /></th>
            <th scope="col" aria-sort="@AriaSort("employeecode")">
              <a class="link-light" href="@SortLink("employeecode")">קוד עובד</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("idnumber")">
              <a class="link-light" href="@SortLink("idnumber")">ת.ז.</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("firstname")">
              <a class="link-light" href="@SortLink("firstname")">שם פרטי</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("lastname")">
              <a class="link-light" href="@SortLink("lastname")">שם משפחה</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("employeerole")">
              <a class="link-light" href="@SortLink("employeerole")">תפקיד</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("userrole")">
              <a class="link-light" href="@SortLink("userrole")">תפקיד מערכת</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("status")">
              <a class="link-light" href="@SortLink("status")">סטטוס</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("isreportingemployee")">
              <a class="link-light" href="@SortLink("isreportingemployee")">עובד מדווח</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("locked")">
              <a class="link-light" href="@SortLink("locked")">נעול</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("email")">
              <a class="link-light" href="@SortLink("email")">מייל</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("phone")">
              <a class="link-light" href="@SortLink("phone")">טלפון</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("restday")">
              <a class="link-light" href="@SortLink("restday")">יום מנוחה</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("allowfuturereporting")">
              <a class="link-light" href="@SortLink("allowfuturereporting")">דיווח עתידי</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("projects")">
              <a class="link-light" href="@SortLink("projects")">פרויקטים</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("districts")">
              <a class="link-light" href="@SortLink("districts")">מחוזות</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("programs")">
              <a class="link-light" href="@SortLink("programs")">תוכניות</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("sectors")">
              <a class="link-light" href="@SortLink("sectors")">מגזרים</a>
            </th>
            <th scope="col" aria-sort="@AriaSort("notes")">
              <a class="link-light" href="@SortLink("notes")">הערות עובד</a>
            </th>
            <th scope="col">הערות הקצאה</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var emp in Model)
          {
            var activeAllocations = emp.Allocations.Where(a => a.IsActive).ToList();
            var isLocked = emp.StatusId == 3 || emp.FailedLoginAttempts >= 3;
            <tr>
              <td>
                <div class="d-flex gap-1 flex-wrap">
                  <a asp-action="Edit" asp-route-id="@emp.Id"
                     class="btn btn-sm btn-primary" title="עריכת כרטיס">עריכה</a>
                  <a asp-action="Allocations" asp-route-id="@emp.Id"
                     class="btn btn-sm btn-success" title="הקצאות">הקצאות</a>
                  <form method="post" action="@Url.Action("ResetPassword", "Employee", new { id = emp.Id })@Context.Request.QueryString"
                        style="display:inline"
                        onsubmit="return confirm('לאפס סיסמה למספר הזהות?')">
                    @Html.AntiForgeryToken()
                    @* Carry the active filter into the redirect (Fix #14). *@
                    <input type="hidden" name="search" value="@filter.Search" />
                    <input type="hidden" name="idNumber" value="@filter.IdNumber" />
                    <input type="hidden" name="employeeCode" value="@filter.EmployeeCode" />
                    <input type="hidden" name="firstName" value="@filter.FirstName" />
                    <input type="hidden" name="lastName" value="@filter.LastName" />
                    @if (filter.StatusId.HasValue) { <input type="hidden" name="statusId" value="@filter.StatusId" /> }
                    @if (filter.RoleId.HasValue) { <input type="hidden" name="roleId" value="@filter.RoleId" /> }
                    @if (filter.RestDay.HasValue) { <input type="hidden" name="restDay" value="@filter.RestDay" /> }
                    @if (filter.LockedOnly) { <input type="hidden" name="lockedOnly" value="true" /> }
                    <button type="submit" class="btn btn-sm btn-outline-warning">אפס סיסמה</button>
                  </form>
                  @if (isLocked)
                  {
                    <form method="post" action="@Url.Action("UnlockAccount", "Employee", new { id = emp.Id })@Context.Request.QueryString"
                          style="display:inline"
                          onsubmit="return confirm('לשחרר את נעילת החשבון?')">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="search" value="@filter.Search" />
                      <input type="hidden" name="firstName" value="@filter.FirstName" />
                      <input type="hidden" name="lastName" value="@filter.LastName" />
                      @if (filter.LockedOnly) { <input type="hidden" name="lockedOnly" value="true" /> }
                      <button type="submit" class="btn btn-sm btn-outline-success">שחרור נעילה</button>
                    </form>
                  }
                  @if (emp.StatusId != 2)
                  {
                    <form method="post" action="@Url.Action("DeleteEmployee", "Employee", new { id = emp.Id })@Context.Request.QueryString"
                          style="display:inline"
                          onsubmit="return confirm('להשבית עובד זה?')">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="search" value="@filter.Search" />
                      <input type="hidden" name="firstName" value="@filter.FirstName" />
                      <input type="hidden" name="lastName" value="@filter.LastName" />
                      <button type="submit" class="btn btn-sm btn-outline-danger">לא פעיל</button>
                    </form>
                  }
                </div>
              </td>
              <td><input type="checkbox" name="selectedIds" value="@emp.Id" class="row-check" aria-label="בחר עובד" /></td>
              <td>@emp.EmployeeCode</td>
              <td>@DisplayIdNumber(emp.IdNumber)</td>
              <td>@emp.FirstName</td>
              <td>@emp.LastName</td>
              <td>@(emp.Role?.Description ?? "-")</td>
              <td>@(emp.UserRole?.DescriptionHebrew ?? emp.UserRole?.Name ?? "-")</td>
              <td>
                @{
                  var statusClass = emp.StatusId switch
                  {
                    1 => "success",
                    2 => "secondary",
                    3 => "danger",
                    _ => "secondary"
                  };
                }
                <span class="badge bg-@statusClass">@(emp.Status?.DescriptionHebrew ?? emp.Status?.Name ?? "-")</span>
              </td>
              <td>@(emp.IsReportingEmployee ? "כן" : "לא")</td>
              <td>@(isLocked ? "כן" : "לא")</td>
              <td>@(string.IsNullOrWhiteSpace(emp.Email) ? "-" : emp.Email)</td>
              <td>@(string.IsNullOrWhiteSpace(emp.Phone) ? "-" : emp.Phone)</td>
              <td>
                @{
                  var rdItem = SelectListProviders.RestDayOptions.FirstOrDefault(o => o.Value == (emp.RestDay?.ToString() ?? string.Empty));
                  @(emp.RestDay.HasValue ? (rdItem?.Text ?? emp.RestDay.ToString()!) : "-")
                }
              </td>
              <td>@(emp.AllowFutureReporting ? "כן" : "לא")</td>
              <td>@Values(activeAllocations.Select(a => a.Project?.Description))</td>
              <td>@Values(activeAllocations.SelectMany(a => a.AllocationDistricts).Select(x => x.District?.Description))</td>
              <td>@Values(activeAllocations.SelectMany(a => a.AllocationPrograms).Select(x => x.Program?.Description))</td>
              <td>@Values(activeAllocations.SelectMany(a => a.AllocationSectors).Select(x => x.Sector?.Description))</td>
              <td>@(string.IsNullOrWhiteSpace(emp.Notes) ? "-" : emp.Notes)</td>
              <td>@Values(activeAllocations.Select(a => a.Notes))</td>
            </tr>
          }
          @if (!Model.Any())
          {
            <tr>
              <td colspan="22" class="text-center text-muted py-4">לא נמצאו עובדים</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </form>

  @if (totalPages > 1)
  {
    <nav aria-label="עימוד">
      <ul class="pagination justify-content-center">
        <li class="page-item @(page <= 1 ? "disabled" : "")">
          <a class="page-link" href="@PageLink(page - 1)">הקודם</a>
        </li>
        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
        {
          <li class="page-item @(i == page ? "active" : "")">
            <a class="page-link" href="@PageLink(i)">@i</a>
          </li>
        }
        <li class="page-item @(page >= totalPages ? "disabled" : "")">
          <a class="page-link" href="@PageLink(page + 1)">הבא</a>
        </li>
      </ul>
    </nav>
  }
</div>

@section Scripts {
  <script>
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.row-check');
    const bulkBar = document.getElementById('bulkBar');
    const selectedCount = document.getElementById('selectedCount');

    function updateBulkBar() {
      const checked = document.querySelectorAll('.row-check:checked').length;
      if (checked > 0) {
        bulkBar.classList.remove('d-none');
        selectedCount.textContent = `נבחרו ${checked} עובדים`;
      } else {
        bulkBar.classList.add('d-none');
      }
    }

    selectAll?.addEventListener('change', function () {
      checkboxes.forEach(cb => cb.checked = this.checked);
      updateBulkBar();
    });

    checkboxes.forEach(cb => cb.addEventListener('change', updateBulkBar));
  </script>
}
